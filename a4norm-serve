#!/usr/bin/env python3
"""a4norm-serve — HTTP front end for a4norm.

    GET  /health                     -> {"status":"ok", ...}
    POST /scan                       -> application/pdf
    POST /scan?format=jpg            -> image/jpeg  (single page only)

Send the images as multipart/form-data (any field names, repeat for several
pages, page order = part order) or, for one image, as a raw request body with an
image content type. Several images always come back as ONE multi-page document:
a paper document is rarely one page.

Query parameters, all optional: format=pdf|jpg, dpi, quality, gray=1,
rectify=auto|on|off, plus any other a4norm flag passed through as
flag=value (dashes or underscores both work, e.g. paper_thr=85).

Stdlib only, like a4norm itself. Concurrency is capped on purpose: one page is
tens of seconds of CPU, so an unbounded server is a denial-of-service switch for
whatever else runs on the box.
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import uuid
from email.parser import BytesParser
from email.policy import default as email_policy
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs

# Flags that are ours, not a4norm's, and must not be forwarded.
RESERVED = {"format", "separate", "o", "output", "preview", "dry-run", "dry_run"}
# Only these characters may appear in a forwarded flag name or value. The values
# end up in an argv list (never a shell), but a flag that looks like a path or a
# redirect has no business being accepted from a request.
SAFE = set("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.,-_%")

EXT = {
    b"\xff\xd8\xff": ".jpg",
    b"\x89PNG\r\n\x1a\n": ".png",
    b"%PDF": ".pdf",
    b"II*\x00": ".tif",
    b"MM\x00*": ".tif",
}


def sniff_ext(blob):
    for magic, ext in EXT.items():
        if blob.startswith(magic):
            return ext
    if len(blob) > 12 and blob[4:8] == b"ftyp":
        brand = blob[8:12]
        if brand in (b"heic", b"heix", b"hevc", b"heim", b"heis", b"mif1",
                     b"msf1", b"avif"):
            return ".heic" if brand != b"avif" else ".avif"
    if blob[:4] == b"RIFF" and blob[8:12] == b"WEBP":
        return ".webp"
    return None


class Handler(BaseHTTPRequestHandler):
    server_version = "a4norm-serve"
    sys_version = ""

    # --- plumbing ---------------------------------------------------------

    def log_message(self, fmt, *args):  # one tidy line per request, to stderr
        sys.stderr.write("%s %s\n" % (time.strftime("%Y-%m-%dT%H:%M:%S"),
                                      fmt % args))

    def _send(self, code, body, ctype="application/json", extra=None):
        if isinstance(body, (dict, list)):
            body = json.dumps(body).encode()
        elif isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def _fail(self, code, msg):
        self.log_message("-> %d %s", code, msg)
        self._send(code, {"error": msg})

    # --- routes -----------------------------------------------------------

    def do_GET(self):
        path = urlparse(self.path).path.rstrip("/") or "/"
        if path in ("/health", "/"):
            return self._send(200, {
                "status": "ok",
                "tool": self.server.opts.a4norm,
                "max_bytes": self.server.opts.max_bytes,
                "max_concurrency": self.server.opts.max_concurrency,
                "busy": self.server.busy,
            })
        return self._fail(404, "not found")

    do_HEAD = do_GET

    def do_POST(self):
        if urlparse(self.path).path.rstrip("/") != "/scan":
            return self._fail(404, "not found")
        o = self.server.opts

        length = int(self.headers.get("Content-Length") or 0)
        if length <= 0:
            return self._fail(411, "Content-Length required")
        if length > o.max_bytes:
            # Drain first. Answering before reading leaves the client writing
            # into a closed socket, so it reports a connection error instead of
            # the 413 — and then nobody knows why the upload "failed".
            left = min(length, o.max_bytes * 4)
            while left > 0:
                chunk = self.rfile.read(min(65536, left))
                if not chunk:
                    break
                left -= len(chunk)
            self.close_connection = True
            return self._fail(413, f"body over {o.max_bytes} bytes")

        q = parse_qs(urlparse(self.path).query)
        one = lambda k, d=None: (q.get(k) or [d])[0]
        fmt = (one("format", "pdf") or "pdf").lower()
        if fmt in ("jpeg", "jpg"):
            fmt = "jpg"
        if fmt not in ("pdf", "jpg"):
            return self._fail(400, "format must be pdf or jpg")

        passthrough = []
        for k, vals in q.items():
            if k in RESERVED:
                continue
            flag = k.replace("_", "-")
            if not set(flag) <= SAFE or not set(vals[0]) <= SAFE:
                return self._fail(400, f"unsafe parameter: {k}")
            if vals[0] in ("1", "true", "yes", ""):
                passthrough.append("--" + flag)
            else:
                passthrough += ["--" + flag, vals[0]]

        body = self.rfile.read(length)
        ctype = self.headers.get("Content-Type", "")

        work = tempfile.mkdtemp(prefix="a4norm-req-")
        try:
            files = self._extract(body, ctype, work)
            if not files:
                return self._fail(400, "no image found in the request")
            if fmt == "jpg" and len(files) > 1:
                return self._fail(400, "jpg output takes a single image; "
                                       "use format=pdf for several")

            if not self.server.slot.acquire(timeout=o.queue_wait):
                return self._fail(503, "busy, try again shortly")
            self.server.busy += 1
            t0 = time.time()
            try:
                out = os.path.join(work, "out." + ("pdf" if fmt == "pdf" else "jpg"))
                cmd = [o.a4norm, "--format", fmt, "-o", out] + passthrough + files
                proc = subprocess.run(cmd, capture_output=True, text=True,
                                      timeout=o.job_timeout)
            except subprocess.TimeoutExpired:
                return self._fail(504, f"timed out after {o.job_timeout}s")
            finally:
                self.server.busy -= 1
                self.server.slot.release()

            if proc.returncode != 0 or not os.path.exists(out):
                tail = (proc.stderr or proc.stdout or "").strip().splitlines()
                self.log_message("a4norm failed rc=%s: %s", proc.returncode,
                                 " | ".join(tail[-3:]))
                return self._fail(500, "processing failed")

            data = open(out, "rb").read()
            secs = time.time() - t0
            self.log_message("-> 200 %s %d pages %d KB in %.1fs",
                             fmt, len(files), len(data) // 1024, secs)
            self._send(200, data,
                       "application/pdf" if fmt == "pdf" else "image/jpeg",
                       {"X-Pages": str(len(files)),
                        "X-Seconds": f"{secs:.1f}",
                        "Content-Disposition":
                            f'attachment; filename="scan.{fmt}"'})
        finally:
            shutil.rmtree(work, ignore_errors=True)

    # --- input ------------------------------------------------------------

    def _extract(self, body, ctype, work):
        """Write every image in the request to disk; return paths in order."""
        paths = []

        def put(blob):
            ext = sniff_ext(blob)
            if not ext:
                return
            p = os.path.join(work, f"in-{len(paths):03d}-{uuid.uuid4().hex[:8]}{ext}")
            open(p, "wb").write(blob)
            paths.append(p)

        if ctype.lower().startswith("multipart/"):
            # email.parser handles the boundary properly; the cgi module that
            # used to do this was removed in Python 3.13.
            msg = BytesParser(policy=email_policy).parsebytes(
                b"Content-Type: " + ctype.encode() + b"\r\n\r\n" + body)
            if msg.is_multipart():
                for part in msg.walk():
                    if part.is_multipart():
                        continue
                    payload = part.get_payload(decode=True)
                    if payload:
                        put(payload)
        else:
            put(body)
        return paths


def main():
    p = argparse.ArgumentParser(prog="a4norm-serve", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--host", default="0.0.0.0")
    p.add_argument("--port", type=int, default=8080)
    p.add_argument("--a4norm", default=shutil.which("a4norm") or "a4norm",
                   help="path to the a4norm executable")
    p.add_argument("--max-bytes", type=int, default=40 * 1024 * 1024,
                   help="reject a request body larger than this")
    p.add_argument("--max-concurrency", type=int, default=1,
                   help="pages processed at once; one page is tens of seconds "
                        "of CPU, so keep this small on a shared machine")
    p.add_argument("--queue-wait", type=float, default=120.0,
                   help="seconds a request may wait for a slot before 503")
    p.add_argument("--job-timeout", type=float, default=600.0,
                   help="seconds one job may run before 504")
    o = p.parse_args()

    if not (os.path.isabs(o.a4norm) and os.access(o.a4norm, os.X_OK)) and \
       not shutil.which(o.a4norm):
        sys.exit(f"a4norm-serve: a4norm not found: {o.a4norm}")

    srv = ThreadingHTTPServer((o.host, o.port), Handler)
    srv.opts = o
    srv.slot = threading.BoundedSemaphore(max(1, o.max_concurrency))
    srv.busy = 0
    srv.daemon_threads = True
    print(f"a4norm-serve on {o.host}:{o.port} "
          f"(concurrency {o.max_concurrency}, max body {o.max_bytes} bytes)",
          file=sys.stderr, flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
