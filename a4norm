#!/usr/bin/env python3
"""a4norm — photos of paper documents -> one scanner-grade A4 PDF.

Per page: rasterize -> rectify the sheet's quadrilateral and erase whatever
leans in from outside it -> orient -> trim the photographic border -> flat-field
the illumination in colour -> deskew -> neutralize the ink cast while keeping
genuinely coloured ink -> tone by histogram percentiles -> erase bright
featureless haze -> clean the paper to white -> fit onto A4 -> JPEG in a PDF
this script writes itself.

Several inputs combine into ONE multi-page document; --separate gives one
document per input. --format jpg writes images instead of a PDF.

Needs ImageMagick 7 (`magick`) and poppler (`pdfinfo`, `pdfimages`,
`pdftoppm`). Python standard library only. No ghostscript.

    a4norm photo.HEIC
    a4norm -o contract.pdf page1.jpg page2.jpg page3.jpg
    a4norm --dry-run --preview photo.HEIC
    a4norm --help
"""

import argparse
import collections
import math
import os
import re
import shutil
import subprocess
import sys
import tempfile

MM = 25.4

# ---------------------------------------------------------------- shell helpers


def run(cmd, **kw):
    return subprocess.run(cmd, check=True, capture_output=True, text=True, **kw).stdout


def magick(*args):
    return run(["magick", "-define", "png:compression-level=0",
                *[str(a) for a in args]])


def fmt(path, expr):
    """One -format value out of an image."""
    return magick(path, "-format", expr, "info:").strip()


def raw_gray(path, w, h):
    """Downscaled 8-bit grayscale bytes, row-major."""
    out = subprocess.run(
        ["magick", str(path), "-colorspace", "gray", "-resize", f"{w}x{h}!",
         "-depth", "8", "gray:-"],
        check=True, capture_output=True).stdout
    return out


def need(tool):
    if not shutil.which(tool):
        sys.exit(f"a4norm: required tool not found: {tool}")


# ------------------------------------------------------------------- analysis


def smooth(v, k=5):
    n, half, out = len(v), k // 2, []
    for i in range(n):
        lo, hi = max(0, i - half), min(n, i + half + 1)
        out.append(sum(v[lo:hi]) / (hi - lo))
    return out


def profiles(path, side=420):
    """Per-row and per-column mean brightness over the central 60% of the frame."""
    w0, h0 = (int(x) for x in fmt(path, "%w %h").split())
    w = side
    h = max(1, round(side * h0 / w0))
    buf = raw_gray(path, w, h)
    x0, x1 = int(w * 0.20), int(w * 0.80)
    y0, y1 = int(h * 0.20), int(h * 0.80)
    rows = [sum(buf[y * w + x0:y * w + x1]) / (x1 - x0) for y in range(h)]
    cols = [sum(buf[y * w + x] for y in range(y0, y1)) / (y1 - y0) for x in range(w)]
    core = sum(rows[y0:y1]) / max(1, y1 - y0)   # brightness of the page itself
    return smooth(rows), smooth(cols), core, w, h, w0, h0


def find_step(prof, core, outer_frac, min_step):
    """Scan inward from the border for the sheet edge, or None if there is none.

    Two conditions, and the second one is the important one:

    1. a hard local step in brightness — the edge itself, a shadow line or the
       transition to the desk;
    2. the strip OUTSIDE that step must not look like the page. Compared against
       the brightness of the page core, a desk (darker or brighter) differs; the
       white margin of an already-clean scan does not.

    Without (2) the first line of text reads as an edge and the top margin of a
    clean scan gets cut off — measured, not hypothetical.
    """
    n = len(prof)
    band = max(6, int(n * outer_frac))
    best_i, best_d = None, 0.0
    for i in range(3, band):
        d = abs(prof[i + 2] - prof[i - 3])
        if d > best_d:
            best_d, best_i = d, i
    if best_i is None or best_d < min_step:
        return None
    outer = prof[:best_i]
    mu = sum(outer) / len(outer)
    var = sum((v - mu) ** 2 for v in outer) / len(outer)
    spread = var ** 0.5
    # "Looks like the page" has to mean page-bright AND uniform. A strip that is
    # half desk and half paper averages out to the page's own brightness -- on a
    # worksheet photographed against a dark surface the top strip measured mean
    # 149.0 against a core of 153.5, so the mean alone threw a 48-unit step away
    # and the sheet lost its top edge. Its spread was 26 where a real page
    # margin's is 2. Both tests have to agree before an edge is discarded.
    if abs(mu - core) < min_step and spread < min_step:
        return None
    return best_i + 2


def detect_border(path, outer_frac, min_step):
    """Photo border to cut, in full-res pixels: (left, right, top, bottom, flags)."""
    rows, cols, core, w, h, w0, h0 = profiles(path)
    sx, sy = w0 / w, h0 / h

    top = find_step(rows, core, outer_frac, min_step)
    bottom = find_step(rows[::-1], core, outer_frac, min_step)
    left = find_step(cols, core, outer_frac, min_step)
    right = find_step(cols[::-1], core, outer_frac, min_step)

    flags = {"top": top is not None, "bottom": bottom is not None,
             "left": left is not None, "right": right is not None}
    return (round((left or 0) * sx), round((right or 0) * sx),
            round((top or 0) * sy), round((bottom or 0) * sy), flags)


def ink_bbox(path, thr=78):
    """Bounding box of the ink, as (x, y, w, h) in full-res pixels."""
    with tempfile.NamedTemporaryFile(suffix=".png", delete=False) as t:
        mask = t.name
    try:
        magick(path, "-colorspace", "gray", "-threshold", f"{thr}%", "-negate",
               "-morphology", "Erode", "Octagon:1", mask)
        geom = fmt_trim(mask)
    finally:
        os.unlink(mask)
    return geom


def fmt_trim(mask):
    # -format MUST come after -trim: the other way round ImageMagick reports the
    # bbox size with a +0+0 offset, which silently anchors the frame corner
    # instead of the ink and pushes the text off the right edge of the page.
    out = run(["magick", mask, "-trim", "-format", "%wx%h%O", "info:"]).strip()
    m = re.match(r"(\d+)x(\d+)([+-]\d+)([+-]\d+)", out)
    if not m:
        return None
    w, h, x, y = (int(g) for g in m.groups())
    return (x, y, w, h)


def deskew_angle(path):
    out = run(["magick", str(path), "-colorspace", "gray", "-threshold", "60%",
               "-deskew", "40%", "-format", "%[deskew:angle]", "info:"]).strip()
    try:
        return float(out)
    except ValueError:
        return 0.0


_OP_CACHE = {}


def _probe_op(names, want_lo, want_hi):
    """Pick the compose alias that means "destination OP source" in THIS build.

    ImageMagick 7.1.1 and 7.1.2 disagree about these names: Divide_Dst on one is
    Divide_Src on the other. A flat-field written with either name therefore
    inverts on the wrong build — the background gets divided by the page, every
    stroke saturates to white, and the output is a blank sheet full of speckle.
    It is a silent failure with a perfectly normal-looking report, so the names
    are never trusted: probe them on two known pixels and use what works.
    """
    key = tuple(names)
    if key in _OP_CACHE:
        return _OP_CACHE[key]
    for n in names:
        try:
            v = float(run(["magick", "-size", "1x1", "xc:#808080",
                           "-size", "1x1", "xc:#404040",
                           "-compose", n, "-composite",
                           "-format", "%[fx:u*255]", "info:"]).strip())
        except (subprocess.CalledProcessError, ValueError):
            continue
        if want_lo <= v <= want_hi:
            _OP_CACHE[key] = n
            return n
    _OP_CACHE[key] = names[0]
    return names[0]


def op_divide():
    """dst / src — 128/64 = 2, which saturates high."""
    return _probe_op(["Divide_Dst", "Divide_Src", "Divide"], 200, 100000)


def op_minus():
    """dst - src — 128-64 = 64."""
    return _probe_op(["MinusSrc", "MinusDst", "Minus"], 40, 90)


def raw_rgb(path, w, h):
    """Downscaled 8-bit RGB bytes, row-major."""
    return subprocess.run(
        ["magick", str(path), "-resize", f"{w}x{h}!", "-depth", "8", "rgb:-"],
        check=True, capture_output=True).stdout


def dims(path):
    return tuple(int(x) for x in fmt(path, "%w %h").split())


def _open4(mask, w, h):
    """4-neighbour erode then dilate — drops speckle without moving real edges."""
    er = bytearray(w * h)
    for y in range(1, h - 1):
        row = y * w
        for x in range(1, w - 1):
            i = row + x
            if mask[i] and mask[i-1] and mask[i+1] and mask[i-w] and mask[i+w]:
                er[i] = 1
    di = bytearray(w * h)
    for y in range(1, h - 1):
        row = y * w
        for x in range(1, w - 1):
            i = row + x
            if er[i] or er[i-1] or er[i+1] or er[i-w] or er[i+w]:
                di[i] = 1
    return di


def _shoelace(pts):
    a = 0.0
    for i in range(len(pts)):
        x1, y1 = pts[i]; x2, y2 = pts[(i + 1) % len(pts)]
        a += x1 * y2 - x2 * y1
    return abs(a) / 2


def _angle(a, b, c):
    """Angle at b, in degrees."""
    v1 = (a[0] - b[0], a[1] - b[1]); v2 = (c[0] - b[0], c[1] - b[1])
    n1 = math.hypot(*v1); n2 = math.hypot(*v2)
    if n1 == 0 or n2 == 0:
        return 0.0
    cos = max(-1.0, min(1.0, (v1[0]*v2[0] + v1[1]*v2[1]) / (n1 * n2)))
    return math.degrees(math.acos(cos))


def _vc(path, side=400):
    """Brightness (max channel) and chroma of a downscaled frame."""
    w0, h0 = dims(path)
    w = side
    h = max(1, round(side * h0 / w0))
    buf = raw_rgb(path, w, h)
    n = w * h
    V = bytearray(n); C = bytearray(n)
    for i in range(n):
        j = i * 3
        r, g, b = buf[j], buf[j+1], buf[j+2]
        v = r if r > g else g
        if b > v: v = b
        m = r if r < g else g
        if b < m: m = b
        V[i] = v; C[i] = v - m
    return V, C, w, h, w0, h0


def _otsu(V):
    """Otsu's threshold of a 0-255 histogram: the split darkest-vs-brightest."""
    hist = [0] * 256
    for v in V:
        hist[v] += 1
    n = len(V)
    tot = sum(i * c for i, c in enumerate(hist))
    sb = wb = 0
    best, thr = -1.0, 128
    for t in range(256):
        wb += hist[t]
        if wb == 0:
            continue
        wf = n - wb
        if wf == 0:
            break
        sb += t * hist[t]
        mb, mf = sb / wb, (tot - sb) / wf
        var = wb * wf * (mb - mf) ** 2
        if var > best:
            best, thr = var, t
    return thr


def paper_mask(path, side=400, vc=None, mode="paper"):
    """The paper-like pixels of the frame: (mask, w, h, w0, h0).

    `paper`, the sheet detector's own rule: bright AND low-chroma, both
    relative to the image's own paper level, so a dim photo works as well as
    a bright one and a desk is either darker or coloured.

    The spread detector tries two looser readings of "paper" when that one
    finds no spread, because passport pages are not white paper:
    `tinted` lets chroma up to 100 through -- an international passport's
    salmon-pink pages measure 60-90 and vanished under the limit of 45 --
    and `otsu` also drops the brightness bar to the image's own split between
    dark and bright, for a booklet whose lower half lies in its own shadow.
    """
    V, C, w, h, w0, h0 = vc or _vc(path, side)
    n = w * h
    paper = sorted(V)[int(0.95 * (n - 1))]
    if mode == "otsu":
        v_thr, c_max = _otsu(V) + 1, 100
    else:
        v_thr = max(60, int(paper * 0.72))
        c_max = 45 if mode == "paper" else 100
    mask = bytearray(n)
    for i in range(n):
        if V[i] >= v_thr and C[i] <= c_max:
            mask[i] = 1
    return _open4(mask, w, h), w, h, w0, h0


def detect_quad(path, side=400, pm=None):
    """Find the sheet as a quadrilateral, or return (None, reason).

    Everything after the mask is checks: a blob that is not convincingly a
    four-cornered sheet is refused, because rectifying on a wrong quad is far
    worse than not rectifying at all.
    """
    mask, w, h, w0, h0 = pm or paper_mask(path, side)
    return _quad_from_mask(mask, w, h, w0, h0)


def _components(mask, w, h):
    """4-connected blobs of a binary mask, largest first, as index lists."""
    n = w * h
    seen = bytearray(n); comps = []
    for s0 in range(n):
        if mask[s0] and not seen[s0]:
            q = collections.deque([s0]); seen[s0] = 1; comp = []
            while q:
                i = q.popleft(); comp.append(i)
                x, y = i % w, i // w
                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    xx, yy = x + dx, y + dy
                    if 0 <= xx < w and 0 <= yy < h:
                        j2 = yy * w + xx
                        if mask[j2] and not seen[j2]:
                            seen[j2] = 1; q.append(j2)
            comps.append(comp)
    comps.sort(key=len, reverse=True)
    return comps


def _quad_from_mask(mask, w, h, w0, h0):
    """Largest blob in a binary mask -> sheet quad, or (None, why, share).

    Split out so a segmentation mask can be judged by exactly the same rules as
    the brightness mask. Every threshold below was tuned against real
    photographs; giving the model its own looser set would be how a photo of a
    desk ends up rectified as if it were paper.
    """
    n = w * h
    comps = _components(mask, w, h)
    best = comps[0] if comps else []
    if not best:
        return None, "no bright low-chroma region found", 0.0
    frac = len(best) / n
    if frac > 0.90:
        return None, f"the sheet already fills the frame ({frac:.0%})", frac
    if frac < 0.15:
        return None, f"the brightest region is too small to be the sheet ({frac:.0%})", frac

    pts = [(i % w, i // w) for i in best]
    tl = min(pts, key=lambda p: p[0] + p[1])
    br = max(pts, key=lambda p: p[0] + p[1])
    tr = max(pts, key=lambda p: p[0] - p[1])
    bl = min(pts, key=lambda p: p[0] - p[1])
    quad = [tl, tr, br, bl]
    if len(set(quad)) < 4:
        return None, "corners collapsed", frac
    qa = _shoelace(quad)
    if qa <= 0 or len(best) / qa < 0.80:
        return None, "the bright region is not shaped like a quadrilateral", frac
    for i in range(4):
        a = _angle(quad[(i - 1) % 4], quad[i], quad[(i + 1) % 4])
        if not 45 <= a <= 135:
            return None, f"corner angle {a:.0f}° is not a sheet corner", frac
    d = lambda a, b: math.hypot(a[0]-b[0], a[1]-b[1])
    top, bot = d(tl, tr), d(bl, br)
    lef, rig = d(tl, bl), d(tr, br)
    if max(top, bot) / max(1e-6, min(top, bot)) > 1.8 or \
       max(lef, rig) / max(1e-6, min(lef, rig)) > 1.8:
        return None, "opposite sides differ too much to be one flat sheet", frac
    sx, sy = w0 / w, h0 / h
    return [(p[0] * sx, p[1] * sy) for p in quad], f"{frac:.0%} of the frame", frac


# How much of a segmented region must read as paper before a4norm will rectify
# on it. Measured across every test photograph here: 60-97% for real sheets,
# 16% for a photo of a desk whose monitor the model picked out. 40 sits in the
# middle of that gap with room on both sides.
SEG_PAPER_MIN = 40.0


def segment_quad(path, side=400):
    """The sheet's quad from a segmentation mask, when brightness cannot find it.

    detect_quad assumes the page is the brightest low-chroma thing in frame. A
    grey till slip on a marble counter, or a white sign on a white wall, break
    that assumption outright -- measured paper-like area 0-3% where the real
    figure is 30-45% -- and no threshold fixes it, because the background really
    is brighter than the paper.

    A segmentation model has no brightness assumption. It answers a different
    question, though: "what stands out here?", not "where is the sheet?". On a
    synthetic letter it picked the signature, 0.2% of the frame; on a photo of a
    desk it happily outlined the clutter. So its answer goes through the SAME
    acceptance tests as the brightness one, and the 80% fill test does the
    separating on its own: 82-98% for every real sheet measured, 48% for the
    desk, 19% for the signature.

    Needs the `a4norm-seg` helper, which only exists in the full image. Without
    it this returns quietly and nothing changes.
    """
    seg = shutil.which("a4norm-seg")
    if not seg:
        here = os.path.join(os.path.dirname(os.path.abspath(sys.argv[0])), "a4norm-seg")
        seg = here if os.access(here, os.X_OK) else None
    if not seg:
        return None, "no segmentation helper installed", 0.0

    work = tempfile.mkdtemp(prefix="a4norm-seg-")
    try:
        mask_png = os.path.join(work, "mask.png")
        try:
            proc = subprocess.run([seg, path, mask_png], capture_output=True,
                                  text=True, timeout=120)
        except (OSError, subprocess.TimeoutExpired) as exc:
            return None, f"segmentation did not run ({exc.__class__.__name__})", 0.0
        if proc.returncode != 0 or not os.path.exists(mask_png):
            tail = (proc.stderr or "").strip().splitlines()
            return None, "segmentation failed" + (f": {tail[-1]}" if tail else ""), 0.0

        w0, h0 = dims(path)
        w = side
        h = max(1, round(side * h0 / w0))
        buf = raw_gray(mask_png, w, h)
        mask = bytearray(1 if v > 128 else 0 for v in buf)
        mask = _open4(mask, w, h)
        quad, why, frac = _quad_from_mask(mask, w, h, w0, h0)
        if quad is None:
            return None, why, frac

        # Shape is not enough. The model answers "what stands out", and on a
        # photograph of a desk what stands out is a monitor -- which really is
        # a bright quadrilateral and sails through every geometric test. So
        # ask the last question the geometry cannot: does the INSIDE of this
        # region look like paper? Same bright/low-chroma rule the brightness
        # detector uses, but measured against the region's own paper level, so
        # a grey till slip counts as paper and a forest photo on a screen does
        # not. Measured: 60-97% for every real sheet here, 16% for the desk.
        rgb = raw_rgb(path, w, h)
        vals = []
        for i in range(w * h):
            if not mask[i]:
                continue
            j = i * 3
            r, g, b = rgb[j], rgb[j + 1], rgb[j + 2]
            v = r if r > g else g
            if b > v: v = b
            m = r if r < g else g
            if b < m: m = b
            vals.append((v, v - m))
        if not vals:
            return None, "segmented region is empty", frac
        paper = sorted(v for v, _ in vals)[int(0.95 * (len(vals) - 1))]
        thr = max(60, int(paper * 0.72))
        share = sum(1 for v, c in vals if v >= thr and c <= 45) / len(vals)
        if share * 100 < SEG_PAPER_MIN:
            return (None, f"the segmented region does not look like paper "
                    f"({share:.0%} of it, under {SEG_PAPER_MIN:.0f}%)", frac)
        return quad, why, frac
    finally:
        shutil.rmtree(work, ignore_errors=True)


# ------------------------------------------------------------------ spreads
#
# An open booklet -- a passport, a record book -- photographed with both pages
# showing. It breaks the one-sheet model three ways at once, all measured on a
# real passport photo:
#
# 1. The sheet detector sees TWO sheets. The spine carries a coloured strip (a
#    passport's red perforation band: chroma 75 against a limit of 45), so the
#    paper mask falls apart into two blobs of 33% each, and the largest-blob
#    rule rectified the white page alone and threw the other one away.
# 2. Even as one blob it is no quadrilateral: the pages curve into the spine,
#    so the outer edge is a flat "V" at the fold. No single homography flattens
#    both halves.
# 3. The hand that holds it open bites into the outer edge.
#
# So a spread is found as two facing pages, each fitted on its own, and the
# fold is where their edges meet.

SPREAD_MIN = 10.0       # % of the frame each page must cover
SPREAD_BALANCE = 0.6    # smaller page / larger page, as blob areas
SPREAD_FILL = 0.45      # blob pixels / fitted page quad; holes are the stamp,
                        # the photo, the ink, and a thumb, a shadow or glare
                        # can take half a page (measured 47-59%)


EDGE_FRAME = 8          # px at the analysis scale (2-3% of it): this close to the frame's
                        # border is the frame, not an edge (the paper mask's
                        # opening already blanks the outermost pixel)


def _side_points(comp, w, P, Q, h=None):
    """The blob's outermost pixel per step along the side P->Q.

    Outermost along the outward normal, so holes in the page (a stamp, a
    photo) do not count, and only the middle 80% of the side is used: a
    rounded booklet corner is not part of either edge.

    A pixel on the frame's own border is not an edge at all: the frame cut
    the region there. A glare above a card that ran up to the top of the
    photo gave the card a perfectly straight "top edge" along the frame,
    with nothing outside it to penalise, and it won.
    """
    L = math.hypot(Q[0] - P[0], Q[1] - P[1])
    if L < 8:
        return []
    ux, uy = (Q[0] - P[0]) / L, (Q[1] - P[1]) / L
    nx, ny = uy, -ux            # outward for tl,tr,br,bl order with y down
    lo, hi = 0.1 * L, 0.9 * L
    best = {}
    for i in comp:
        x, y = i % w, i // w
        dx, dy = x - P[0], y - P[1]
        t = dx * ux + dy * uy
        if t < lo or t > hi:
            continue
        s = dx * nx + dy * ny
        k = int(t)
        b = best.get(k)
        if b is None or s > b[0]:
            best[k] = (s, x, y)
    # Where the region runs into the frame's border its edge is not seen at
    # all, so that step along the side is dropped whole -- dropping only the
    # border pixels makes the next ones in, a straight line again, the edge.
    return [(x, y) for _, x, y in best.values()
            if not h or (EDGE_FRAME <= x < w - EDGE_FRAME
                         and EDGE_FRAME <= y < h - EDGE_FRAME)]


def _fit_line(pts, trim=True):
    """Total-least-squares line through `pts`, trimming what bites inward.

    A thumb over the edge, a torn corner, a signature running off the page:
    each is a run of edge points well inside the true edge. Refitting on the
    points within 3 MAD of the line drops them in two or three rounds.
    Returns (cx, cy, dx, dy, res) -- `res` the median distance of the kept
    points from the line, in px, which says how straight the edge really
    was -- or None.
    """
    pts = list(pts)
    for _ in range(4 if trim else 1):
        if len(pts) < 6:
            return None
        n = len(pts)
        cx = sum(p[0] for p in pts) / n
        cy = sum(p[1] for p in pts) / n
        sxx = sum((p[0] - cx) ** 2 for p in pts)
        syy = sum((p[1] - cy) ** 2 for p in pts)
        sxy = sum((p[0] - cx) * (p[1] - cy) for p in pts)
        a = 0.5 * math.atan2(2 * sxy, sxx - syy)
        dx, dy = math.cos(a), math.sin(a)
        res = [abs(-(p[0] - cx) * dy + (p[1] - cy) * dx) for p in pts]
        med = sorted(res)[n // 2]
        lim = max(1.0, 3 * med * 1.4826)
        kept = [p for p, r in zip(pts, res) if r <= lim]
        if not trim or len(kept) == n:
            break
        pts = kept
    return (cx, cy, dx, dy, med)


def _cross(l1, l2):
    """Intersection of two lines, or None when they are (nearly) parallel."""
    x1, y1, a1, b1 = l1[:4]
    x2, y2, a2, b2 = l2[:4]
    den = a1 * b2 - b1 * a2
    if abs(den) < 1e-9:
        return None
    t = ((x2 - x1) * b2 - (y2 - y1) * a2) / den
    return (x1 + t * a1, y1 + t * b1)


def _line_angle(l1, l2):
    """Angle between two lines, 0-90 degrees."""
    c = abs(l1[2] * l2[2] + l1[3] * l2[3])
    return math.degrees(math.acos(min(1.0, c)))


EDGE_BAND = 1.5         # px at the analysis scale: on the edge
EDGE_OUT = 3.0          # px: paper this far OUTSIDE a line means it is no edge
EDGE_PENALTY = 1.0      # score lost per point outside, against 1 per point on.
                        # 3 lost a card's top edge to a glare spur standing
                        # above it (the spur's top won with 24% support over
                        # the edge's 70%); a thumb's line still loses at 1,
                        # since the real edge it leaves outside outnumbers
                        # the thumb's own points


def _edge_line(pts, P, Q):
    """The page's true edge among the side's outermost points.

    A finger over the edge only ever takes paper away -- it bites INTO the
    page -- and on a passport held open it can cover most of a side, far more
    than any trimming of outliers survives: the plain fit followed the thumb
    and measured a residual of 10 px. So the edge is chosen as a support
    line: of the lines through pairs of edge points, the one that the most
    points lie on, penalised for every point of paper left outside it, since
    nothing of the page lies beyond its own edge. A thumb's outline
    is curved and leaves the real edge outside it; a straight run of real
    edge, however short, wins. The pairs are fixed strides through the
    points, so the choice is deterministic. Returns the refitted line with
    its inlier share appended, or None.
    """
    L = math.hypot(Q[0] - P[0], Q[1] - P[1])
    if L < 8 or len(pts) < 12:
        return None
    ux, uy = (Q[0] - P[0]) / L, (Q[1] - P[1]) / L
    nx, ny = uy, -ux
    pts = sorted(pts, key=lambda p: (p[0] - P[0]) * ux + (p[1] - P[1]) * uy)
    n = len(pts)
    best = None
    for stride in (n // 8, n // 5, n // 3, n // 2):
        if stride < 3:
            continue
        for i in range(0, n - stride, max(1, n // 40)):
            a, b = pts[i], pts[i + stride]
            lx, ly = b[0] - a[0], b[1] - a[1]
            ll = math.hypot(lx, ly)
            if ll < 1:
                continue
            # the line's own normal, turned to point outward like the side's
            mx, my = ly / ll, -lx / ll
            if mx * nx + my * ny < 0:
                mx, my = -mx, -my
            on = out = 0
            for p in pts:
                s = (p[0] - a[0]) * mx + (p[1] - a[1]) * my
                if abs(s) <= EDGE_BAND:
                    on += 1
                elif s > EDGE_OUT:
                    out += 1
            score = on - EDGE_PENALTY * out
            if best is None or score > best[0]:
                best = (score, a, mx, my)
    if best is None:
        return None
    _, a, mx, my = best
    inl = [p for p in pts
           if abs((p[0] - a[0]) * mx + (p[1] - a[1]) * my) <= EDGE_BAND]
    ln = _fit_line(inl, trim=False)
    if ln is None:
        return None
    return ln + (len(inl) / n,)


def _page_lines(comp, w, h=None):
    """Four edge lines of one page blob: {"top", "right", "bottom", "left"}.

    Each line is (cx, cy, dx, dy, residual, support): `support` is the share
    of the side's edge points that lie on it -- low when a hand hid the edge.
    """
    pts = [(i % w, i // w) for i in comp]
    tl = min(pts, key=lambda p: p[0] + p[1])
    br = max(pts, key=lambda p: p[0] + p[1])
    tr = max(pts, key=lambda p: p[0] - p[1])
    bl = min(pts, key=lambda p: p[0] - p[1])
    lines = {}
    for name, P, Q in (("top", tl, tr), ("right", tr, br),
                       ("bottom", br, bl), ("left", bl, tl)):
        ln = _edge_line(_side_points(comp, w, P, Q, h), P, Q)
        if ln is None:
            return None
        lines[name] = ln
    return lines


FOLD_ANGLE = 1.5        # degrees an edge must bend by at the fold, or
FOLD_STEP = 1.0         # % of the page it must step by, to count as a fold
FOLD_GAIN = 0.6         # two lines must fit the edge this much better than one


def _kink(pts, P, Q, short):
    """Where along the side P->Q its edge bends or steps, as (t, point), or None.

    The side's edge points are split in two at every position in the middle
    third, a line is fitted to each part, and the split that fits best wins.
    It counts as a fold only if two lines fit clearly better than one AND the
    two differ for real -- bent by FOLD_ANGLE degrees, or stepped by FOLD_STEP
    percent of the page's short side. A flat sheet's edge is one line, and
    its best split finds two copies of it.
    """
    L = math.hypot(Q[0] - P[0], Q[1] - P[1])
    ux, uy = (Q[0] - P[0]) / L, (Q[1] - P[1]) / L
    tp = sorted((((p[0] - P[0]) * ux + (p[1] - P[1]) * uy) / L, p) for p in pts)
    if len(tp) < 30:
        return None
    one = _fit_line([p for _, p in tp], trim=False)
    if one is None:
        return None
    best = None
    for k in range(35, 66, 2):
        t = k / 100.0
        a = [p for tt, p in tp if tt < t]
        b = [p for tt, p in tp if tt >= t]
        la, lb = _fit_line(a, trim=False), _fit_line(b, trim=False)
        if la is None or lb is None:
            continue
        err = (la[4] * len(a) + lb[4] * len(b)) / len(tp)
        if best is None or err < best[0]:
            best = (err, t, la, lb)
    if best is None:
        return None
    err, t, la, lb = best
    if err > FOLD_GAIN * one[4]:
        return None
    X = (P[0] + t * L * ux, P[1] + t * L * uy)
    # where each half's line crosses the split position, across the side
    def at(l):
        c = _cross(l, (X[0], X[1], -uy, ux))
        return c or X
    pa, pb = at(la), at(lb)
    step = math.hypot(pa[0] - pb[0], pa[1] - pb[1])
    if _line_angle(la, lb) < FOLD_ANGLE and step < FOLD_STEP / 100.0 * short:
        return None
    return t, ((pa[0] + pb[0]) / 2, (pa[1] + pb[1]) / 2)


def _split_blob(comp, w):
    """One paper region that is really two pages: split it at the fold.

    A spread with no coloured strip between its pages -- an international
    passport -- is one blob. Its long edges give the fold away: both bend or
    step in the middle, where the two pages meet at an angle or the upper one
    lies narrower in perspective. Returns (comp_a, comp_b) or None.
    """
    lines = _page_lines(comp, w)
    if lines is None:
        return None
    tl = _cross(lines["top"], lines["left"]); tr = _cross(lines["top"], lines["right"])
    br = _cross(lines["bottom"], lines["right"]); bl = _cross(lines["bottom"], lines["left"])
    if None in (tl, tr, br, bl):
        return None
    d = lambda a, b: math.hypot(a[0] - b[0], a[1] - b[1])
    wd = (d(tl, tr) + d(bl, br)) / 2
    ht = (d(tl, bl) + d(tr, br)) / 2
    short = min(wd, ht)
    # the fold crosses the LONG sides; both are walked the same way round
    sides = ((tl, bl), (tr, br)) if ht >= wd else ((tl, tr), (bl, br))
    folds = []
    for P, Q in sides:
        # _side_points wants the tl,tr,br,bl winding for its outward normal
        a, b = (Q, P) if (P, Q) in ((tl, bl), (bl, br)) else (P, Q)
        k = _kink(_side_points(comp, w, a, b), P, Q, short)
        if k is None:
            return None
        folds.append(k)
    (t1, f1), (t2, f2) = folds
    if abs(t1 - t2) > 0.15:
        return None
    fx, fy = f2[0] - f1[0], f2[1] - f1[1]
    a, b = [], []
    for i in comp:
        x, y = i % w, i // w
        (a if fx * (y - f1[1]) - fy * (x - f1[0]) < 0 else b).append(i)
    return a, b


SPREAD_V = 12.0         # degrees: the two pages' edges meet at the fold in a
                        # shallow "V"; wider than this, and with little
                        # support, one of them was fitted to a hand
SPREAD_SUPPORT = 0.35   # share of a side's edge points its line must carry


def detect_spread(pm):
    """Two facing pages of an open booklet, or (None, None, why).

    Returns ([quad_a, quad_b], axis, why): the quads in full-resolution pixels,
    each tl,tr,br,bl, in reading order across the spine -- left then right
    when the pages lie side by side ("h"), top then bottom when stacked ("v").
    """
    mask, w, h, w0, h0 = pm
    n = w * h
    comps = _components(mask, w, h)[:2]
    if not comps:
        return None, None, "no paper region"
    how = "two paper regions"
    a = len(comps[0]) / n
    b = len(comps[1]) / n if len(comps) > 1 else 0.0
    if b * 100 < SPREAD_MIN and a * 100 >= 2 * SPREAD_MIN:
        halves = _split_blob(comps[0], w)
        if halves:
            comps = sorted(halves, key=len, reverse=True)
            a, b = len(comps[0]) / n, len(comps[1]) / n
            how = "one paper region folded in the middle"
    if len(comps) < 2 or b * 100 < SPREAD_MIN:
        return None, None, (f"the second paper region covers {b:.0%} of the "
                            f"frame, too little for a facing page")
    if b / a < SPREAD_BALANCE:
        return None, None, (f"the two paper regions differ too much in size "
                            f"({a:.0%} and {b:.0%}) to be facing pages")
    fits = [_page_lines(c, w) for c in comps]
    if None in fits:
        return None, None, "a page edge could not be fitted"
    cen = [(sum(i % w for i in c) / len(c), sum(i // w for i in c) / len(c))
           for c in comps]
    horiz = abs(cen[1][0] - cen[0][0]) >= abs(cen[1][1] - cen[0][1])
    k = 0 if horiz else 1
    order = sorted(range(2), key=lambda i: cen[i][k])
    A, B = (dict(fits[i]) for i in order)
    cA, cB = (comps[i] for i in order)

    # The edges that meet at the fold come in pairs, one from each page, in
    # a shallow "V". When a hand hid nearly all of one of them, what was
    # fitted there is the hand, and it leaves the V: the pair then shares the
    # edge that has the support.
    fixed = []
    for side in (("top", "bottom") if horiz else ("left", "right")):
        la, lb = A[side], B[side]
        if _line_angle(la, lb) > SPREAD_V and min(la[5], lb[5]) < SPREAD_SUPPORT:
            if la[5] < lb[5]:
                A[side] = lb
            else:
                B[side] = la
            fixed.append(side)

    def fold(end_a, end_b, inner_a, inner_b):
        """Where the two pages' edges meet at one end of the spine.

        Normally the intersection of the two edge lines: the pages curve into
        the fold, so their edges form a "V" whose vertex IS the fold. When the
        booklet lies flat the lines are parallel and the vertex runs off to
        infinity; then the fold is midway between the two inner corners.
        """
        ca = _cross(A[end_a], A[inner_a])
        cb = _cross(B[end_b], B[inner_b])
        if ca is None or cb is None:
            return None
        mid = ((ca[0] + cb[0]) / 2, (ca[1] + cb[1]) / 2)
        v = _cross(A[end_a], B[end_b])
        gap = math.hypot(ca[0] - cb[0], ca[1] - cb[1])
        if v is None or math.hypot(v[0] - mid[0], v[1] - mid[1]) > \
                gap / 2 + 0.03 * max(w, h):
            return mid
        return v

    if horiz:
        f1 = fold("top", "top", "right", "left")
        f2 = fold("bottom", "bottom", "right", "left")
        if f1 is None or f2 is None:
            return None, None, "the fold could not be located"
        qa = [_cross(A["top"], A["left"]), f1, f2, _cross(A["bottom"], A["left"])]
        qb = [f1, _cross(B["top"], B["right"]), _cross(B["bottom"], B["right"]), f2]
    else:
        f1 = fold("left", "left", "bottom", "top")
        f2 = fold("right", "right", "bottom", "top")
        if f1 is None or f2 is None:
            return None, None, "the fold could not be located"
        qa = [_cross(A["left"], A["top"]), _cross(A["right"], A["top"]), f2, f1]
        qb = [f1, f2, _cross(B["right"], B["bottom"]), _cross(B["left"], B["bottom"])]
    quads = [qa, qb]
    for q, comp in zip(quads, (cA, cB)):
        if None in q:
            return None, None, "a page corner could not be located"
        for i in range(4):
            ang = _angle(q[(i - 1) % 4], q[i], q[(i + 1) % 4])
            if not 45 <= ang <= 135:
                return None, None, f"page corner angle {ang:.0f}° is not a page corner"
        area = _shoelace(q)
        fill = len(comp) / area if area > 0 else 0
        if not SPREAD_FILL <= fill <= 1.1:
            return None, None, (f"a page region fills {fill:.0%} of its fitted "
                                f"outline, not a page")
        d = lambda p, r: math.hypot(p[0] - r[0], p[1] - r[1])
        if max(d(q[0], q[1]), d(q[3], q[2])) > 1.8 * min(d(q[0], q[1]), d(q[3], q[2])) or \
           max(d(q[0], q[3]), d(q[1], q[2])) > 1.8 * min(d(q[0], q[3]), d(q[1], q[2])):
            return None, None, "opposite page edges differ too much to be one flat page"
    sx, sy = w0 / w, h0 / h
    quads = [[(p[0] * sx, p[1] * sy) for p in q] for q in quads]
    why = f"{how}, {a:.0%} + {b:.0%} of the frame"
    if fixed:
        why += f"; the {' and '.join(fixed)} edge taken from the facing page"
    return quads, ("h" if horiz else "v"), why


def _ink_runs(path, side=600):
    """(horizontal, vertical) ink in long runs: which way the lines of text go.

    Text is letters close together along a line and far apart across it, so
    after bridging the gaps between letters the runs ALONG the lines are long
    and the runs across them are one letter high. Printed rules and form
    underlines point the same way as the text they carry. Measured on a
    passport spread: 0.26 as photographed, 3.79 turned a quarter; 1.74 and 1.40
    on the two ordinary examples.
    """
    w0, h0 = dims(path)
    if w0 >= h0:
        w, h = side, max(1, round(side * h0 / w0))
    else:
        w, h = max(1, round(side * w0 / h0)), side
    raw = subprocess.run(
        ["magick", str(path), "-resize", f"{w}x{h}!", "-colorspace", "gray",
         "(", "+clone", "-morphology", "Close", "Octagon:3", "-blur", "0x2", ")",
         "-compose", op_divide(), "-composite", "-threshold", "75%",
         "-depth", "8", "gray:-"], check=True, capture_output=True).stdout
    minlen = max(8, round(0.025 * max(w, h)))

    def runs(n_lines, n_len, at, gap=2):
        tot = 0
        for a in range(n_lines):
            cur = hole = 0
            for b in range(n_len):
                if raw[at(a, b)] < 128:
                    cur = cur + hole + 1 if cur else 1
                    hole = 0
                elif cur:
                    hole += 1
                    if hole > gap:
                        if cur >= minlen:
                            tot += cur
                        cur = hole = 0
            if cur >= minlen:
                tot += cur
        return tot

    return (runs(h, w, lambda y, x: y * w + x),
            runs(w, h, lambda x, y: y * w + x))


# A face photograph on a document: the hair, the eyes, the jacket make a
# compact block where most of the pixels are well below the paper level, which
# nothing else on a document does over that area -- a text block is a few
# percent ink, a stamp is coloured and so bright in its strongest channel.
PHOTO_CELL = 8          # px of the 400 px analysis image per cell
PHOTO_DARK = 0.78       # a pixel darker than this share of paper is "not paper"
PHOTO_CELL_MIN = 0.45   # a cell this dark counts as photograph
PHOTO_AREA = (1.0, 30.0)  # % of the image the block may cover
PHOTO_FILL = 0.4        # a photo's dark cells fill this much of its box:
                        # hair and clothes, with the lighter face between
                        # (0.44-0.57 measured on passport photos)
PHOTO_TRIES = 4         # dark blocks tried, largest first
PHOTO_REACH = 6         # cells: dark things smaller than twice this are
                        # filled in by the paper-level estimate (a photo is
                        # 8-12 cells across), larger ones are the light


def _dark_cells(path, side):
    """Cells of a downscaled copy that are mostly darker than the paper NEAR
    them: (dark, cw, ch, w, w0) or None when the image is too small.
    Shared by the face-photo search on a page and on a card."""
    w0, h0 = dims(path)
    if w0 >= h0:
        w, h = side, max(1, round(side * h0 / w0))
    else:
        w, h = max(1, round(side * w0 / h0)), side
    buf = raw_rgb(path, w, h)
    n = w * h
    V = bytearray(n)
    for i in range(n):
        j = i * 3
        r, g, b = buf[j], buf[j + 1], buf[j + 2]
        v = r if r > g else g
        V[i] = b if b > v else v
    c = PHOTO_CELL
    cw, ch = w // c, h // c
    if cw < 4 or ch < 4:
        return None
    # "Darker than the paper" means the paper NEAR the cell. A booklet held
    # open is lit unevenly -- one measured with its lower half in shadow read
    # half the page as "dark" against the frame's paper level, one block of
    # 54% of the page. So the paper level is estimated per cell: each cell's
    # brightest pixels, then a closing on the cell grid -- a max filter, then
    # a min filter, PHOTO_REACH cells each. The max fills in anything dark and
    # smaller than that (the photo, the text) from the paper around it; the
    # min brings back the shape of the light, so a shadow larger than that
    # stays in the estimate and divides out.
    top = []
    for cy in range(ch):
        for cx in range(cw):
            vals = sorted(V[y * w + x] for y in range(cy * c, cy * c + c)
                          for x in range(cx * c, cx * c + c))
            top.append(vals[int(0.9 * (len(vals) - 1))])
    r = PHOTO_REACH

    def filt(src, pick):
        # separable: along the rows, then down the columns
        tmp = [pick(src[cy * cw + xx]
                    for xx in range(max(0, cx - r), min(cw, cx + r + 1)))
               for cy in range(ch) for cx in range(cw)]
        return [pick(tmp[yy * cw + cx]
                     for yy in range(max(0, cy - r), min(ch, cy + r + 1)))
                for cy in range(ch) for cx in range(cw)]

    bg = filt(filt(top, max), min)
    dark = bytearray(cw * ch)
    for cy in range(ch):
        for cx in range(cw):
            lim = PHOTO_DARK * bg[cy * cw + cx]
            cnt = 0
            for y in range(cy * c, cy * c + c):
                row = y * w
                for x in range(cx * c, cx * c + c):
                    if V[row + x] < lim:
                        cnt += 1
            if cnt >= PHOTO_CELL_MIN * c * c:
                dark[cy * cw + cx] = 1
    return dark, cw, ch, w, w0


def find_photo_block(path, side=400, area_max=None, fill=None, aspect=None,
                     area_min=None):
    """Bounding box (x, y, w, h) of a face photo on the page, or None.

    Cells of the analysis image that are mostly darker than the paper, joined
    4-connected; the largest such group is a photograph when it is compact
    (it fills at least half of its own box), of a portrait's proportions and
    of a photograph's size. The box is then grown a little: the dark cells
    are the hair, the eyes, the collar, and they reach the top of a portrait
    but not quite its sides or its bottom (a light jacket). Measured on a
    passport photo, 15% at the sides and bottom and 5% at the top covers the
    picture without reaching the printed ornament around it. The page is
    upright by the time this runs, so "top" means top.
    """
    got = _dark_cells(path, side)
    if got is None:
        return None
    dark, cw, ch, w, w0 = got
    c = PHOTO_CELL
    # The largest dark block is not always the photo: a shadow along the
    # spine can be larger. Blocks are taken largest first, and the first one
    # shaped like a photograph wins.
    for comp in _components(dark, cw, ch)[:PHOTO_TRIES]:
        xs = [i % cw for i in comp]; ys = [i // cw for i in comp]
        bw, bh = max(xs) - min(xs) + 1, max(ys) - min(ys) + 1
        share = 100.0 * bw * bh / (cw * ch)
        if ((area_min or PHOTO_AREA[0]) <= share <= (area_max or PHOTO_AREA[1])
                and len(comp) >= (fill or PHOTO_FILL) * bw * bh
                and (aspect or (0.4, 2.5))[0] <= bw / bh <= (aspect or (0.4, 2.5))[1]):
            break
    else:
        return None
    x0 = max(0.0, min(xs) - 0.15 * bw); y0 = max(0.0, min(ys) - 0.05 * bh)
    x1 = min(cw, max(xs) + 1 + 0.15 * bw); y1 = min(ch, max(ys) + 1 + 0.15 * bh)
    s = w0 / w
    return (round(x0 * c * s), round(y0 * c * s),
            round((x1 - x0) * c * s), round((y1 - y0) * c * s))


SPREAD_PHOTO_MM = (38, 48)  # a passport photo is 35 x 45 mm; a little
                        # over, for its frame and for the fit being loose
SPREAD_PHOTO_DARK = 0.25
SPREAD_PHOTO_PLACE = (0.03, 0.37, 0.58, 0.98)  # x0, x1, y0, y1 of the
                        # upright spread: the lower page's left third


def spread_turn(path, axis, report):
    """Degrees to turn a rectified spread so its text reads upright.

    Deterministic, from the page itself, in two steps:

    1. Which way the lines of text run (`_ink_runs`). Text goes across the
       page; a spread whose lines run up and down is turned a quarter.
    2. Which of the two remaining ways is up. A document with a face photo
       carries it on the LEFT of its page -- the Russian passport's page 3,
       the ICAO data page of every travel document -- so of the two
       candidates, the one that puts the photograph in the left half wins.

    When the second step has nothing to go on the spread is turned the way
    that keeps the first page at the top and said so, because a
    wrong-way-up page is a keypress to fix and a guess presented as a fact is
    not.
    """
    hr, vr = _ink_runs(path)
    ratio = hr / max(1, vr)
    if ratio >= 1.6:
        cands = (0, 180)
    elif ratio <= 1 / 1.6:
        cands = (90, 270)
    else:
        report.append(f"spread: text direction unclear (runs across/along "
                      f"{ratio:.2f}) — left as photographed; pass --rotate")
        return 0
    lines = "across" if cands[0] == 0 else "up and down"
    iw, ih = dims(path)
    # The photo has a known place: the left third of the LOWER page, once
    # the pages are stacked the right way up (RU page 3, the ICAO data page).
    # So each candidate turn is tried on a small copy and that place is
    # measured, as on a card -- a search over the whole spread found a dark
    # band of shadow or a hologram as often as the face.
    scored = []
    for turn in cands:
        if (axis == "h") == (turn in (0, 180)):
            continue            # pages side by side after this turn
        small = f"{path}.turn{turn}.png"
        magick(path, "-resize", "400x400", "-rotate", str(turn), small)
        got = _dark_cells(small, 200)
        os.unlink(small)
        if got is None:
            continue
        d, r = _place(got, *SPREAD_PHOTO_PLACE)
        scored.append((d, r, turn))
    # A photo in its place either looks like one on its own (dark, and dark
    # in unbroken columns, as on a card), or it is simply far darker there
    # than the other turn's place: a light portrait on a light background
    # breaks the columns (measured 0.32 dark, 0.00 columns), but the same
    # place turned half round held 0.02.
    pick = None
    if len(scored) == 2:
        (d1, r1, t1), (d2, r2, t2) = sorted(scored, reverse=True)
        if d1 >= SPREAD_PHOTO_DARK and d1 >= 3 * d2 + 0.02:
            pick = t1
    for d, r, t in scored:
        if pick is None and d >= CARD_FACE_DARK and r >= CARD_FACE_RUN:
            pick = t
    if pick is not None:
        turn = pick
        report.append(f"spread: text runs {lines} (ratio {ratio:.2f}); the "
                      f"face photo is in its place, left on the lower page, "
                      f"when turned {turn}°")
        return turn
    box = find_photo_block(path)
    if box:
        cx, cy = box[0] + box[2] / 2, box[1] + box[3] / 2
        for turn in cands:
            # the photo's centre and the frame width after the turn (clockwise)
            x, W = {0: (cx, iw), 180: (iw - cx, iw),
                    90: (ih - cy, ih), 270: (cy, ih)}[turn]
            # Where the spine ends up decides what "its page" is: pages side
            # by side after the turn are half the width each, stacked pages
            # are the full width.
            side_by_side = (axis == "h") == (turn in (0, 180))
            if side_by_side:
                W = W / 2
                x = x % W
            if x < W / 2:
                report.append(f"spread: text runs {lines} (ratio {ratio:.2f}); "
                              f"the photo sits left of its page when turned "
                              f"{turn}°")
                return turn
    turn = cands[0]
    report.append(f"spread: text runs {lines} (ratio {ratio:.2f}); no face "
                  f"photo to tell up from down — turned {turn}°, pass "
                  f"--rotate if it came out upside down")
    return turn


# -------------------------------------------------------------------- cards
#
# An identity card, a driving licence, a bank card: ISO/IEC 7810 ID-1, 85.60 x
# 53.98 mm, corners rounded to 3.18 mm. It is photographed far more often than
# any sheet, usually both sides, usually in a hand. What makes it a card and
# not a sheet is its proportion -- 1.586, where A4 is 1.414 and a passport
# page 1.42 -- and a card is laid out at its real size, front above back, on
# one A4: the copy an office asks for.

CARD_MM = (85.60, 53.98)
CARD_RADIUS_MM = 3.18
CARD_ASPECT = (1.50, 1.68)  # measured long/short of the fitted quad; 1.586
                            # true, perspective moves it a few percent
CARD_MIN = 2.0          # % of the frame a card must cover
CARD_FILL = 0.6         # blob pixels / fitted quad: the face photo, the
                        # print and the glare are holes in the paper mask
CARD_OF_SPREAD = 0.7    # a card this much of a "spread's" area is that
                        # spread -- one card split at a kink, not two pages
CARD_GAP = 4.0          # % of a card's short side: two card-shaped regions
                        # closer than this are two pages of one booklet


def _card_quad(comp, w, h=None):
    """The fitted quad of one blob if it is shaped like an ID-1 card, or None.

    Returns (quad, aspect) with the quad as tl,tr,br,bl at analysis scale.
    A card is rigid and flat, so its corners stay near square in any sane
    photo (60-120 degrees) and its opposite sides near equal; its corners
    are rounded, which the support-line fit ignores -- only the middle 80%
    of each side is fitted, and the lines meet where the square corner
    would be.
    """
    # frame-border pixels are no edge (see _side_points); a card that really
    # reaches the border keeps them, or it would have a side with no points
    lines = _page_lines(comp, w, h) or _page_lines(comp, w)
    if lines is None:
        return None
    q = [_cross(lines["top"], lines["left"]), _cross(lines["top"], lines["right"]),
         _cross(lines["bottom"], lines["right"]), _cross(lines["bottom"], lines["left"])]
    if None in q:
        return None
    for i in range(4):
        if not 60 <= _angle(q[(i - 1) % 4], q[i], q[(i + 1) % 4]) <= 120:
            return None
    d = lambda a, b: math.hypot(a[0] - b[0], a[1] - b[1])
    top, bot, lef, rig = d(q[0], q[1]), d(q[3], q[2]), d(q[0], q[3]), d(q[1], q[2])
    if max(top, bot) > 1.35 * min(top, bot) or max(lef, rig) > 1.35 * min(lef, rig):
        return None
    area = _shoelace(q)
    if area <= 0 or not CARD_FILL <= len(comp) / area <= 1.1:
        return None
    wd, ht = (top + bot) / 2, (lef + rig) / 2
    aspect = max(wd, ht) / min(wd, ht)
    if not CARD_ASPECT[0] <= aspect <= CARD_ASPECT[1]:
        return None
    return q, aspect


def detect_cards(src, vc):
    """One or two ID-1 cards in the frame: ([quad, ...], why) or (None, why).

    Every reading of "paper" the spread detector uses is tried in turn -- a
    card is rarely white: pink, blue-grey, laminated -- and in each the few
    largest regions are fitted. Two cards must be of a size (a front and a
    back) and apart: two card-shaped regions touching along a side are the
    pages of a booklet, which is the spread detector's business.
    """
    V, C, w, h, w0, h0 = vc
    n = w * h
    whys = []
    for mode in ("paper", "tinted", "otsu"):
        mask = paper_mask(src, vc=vc, mode=mode)[0]
        found = []
        for comp in _components(mask, w, h)[:4]:
            share = 100.0 * len(comp) / n
            if share < CARD_MIN:
                break
            got = _card_quad(comp, w, h)
            if got:
                found.append((got[0], got[1], share))
        if not found:
            whys.append(f"{mode}: no card-shaped region")
            continue
        found = found[:2]
        if len(found) == 2:
            a1, a2 = _shoelace(found[0][0]), _shoelace(found[1][0])
            short = math.sqrt(min(a1, a2) / CARD_ASPECT[0])
            gap = min(math.hypot(p[0] - r[0], p[1] - r[1])
                      for p in found[0][0] for r in found[1][0])
            if min(a1, a2) < 0.6 * max(a1, a2):
                found = found[:1]
            elif gap < CARD_GAP / 100.0 * short:
                return None, (f"{mode}: two card-shaped regions touching — "
                              f"a booklet, not two cards")
        sx, sy = w0 / w, h0 / h
        quads = [[(p[0] * sx, p[1] * sy) for p in q] for q, _, _ in found]
        why = ", ".join(f"{s:.0f}% of the frame, sides {a:.2f}:1"
                        for _, a, s in found)
        return quads, f"{why}, {mode} paper mask"
    return None, "; ".join(whys)


# ------------------------------------------------------------ edge finding
#
# Every detector above finds the document as PAPER: bright, low-chroma, or at
# least brighter than Otsu's split. That is simply false for a white page on
# a white desk, a pale card on a white car roof, a pink passport over a light
# floor -- and for a page whose colour illustrations fall out of every paper
# mask, leaving a scrap of it. What those photos still have is an EDGE: a
# long straight step in brightness or in colour where the document ends.
#
# So the frame is also read as lines: Canny edges -- of the brightness AND of
# the saturation, because a lilac card on white paint barely steps in
# brightness and a white page on grey barely in colour -- then a Hough
# transform, and every pair of near-horizontal lines with every pair of
# near-vertical ones is a candidate quadrilateral. A candidate is scored by
# how much of its outline is actually edge.

EDGE_SIDE = 600         # px, long side of the image the lines are read on
EDGE_LINES = 16         # strongest lines per direction that are combined
EDGE_SUPPORT = 0.45     # every side must be edge over this share of it
EDGE_SHEET = 0.60       # ...and this much, before a quad replaces a sheet


def edge_quads(path):
    """Candidate document quads from straight edges, best first.

    Returns (cands, lines, w, h, w0, h0): cands a list of dicts {quad, score,
    minsup, share} at the analysis scale (quad tl,tr,br,bl), lines the Hough
    lines with a support function for any segment of them.
    """
    w0, h0 = dims(path)
    if w0 >= h0:
        w, h = EDGE_SIDE, max(1, round(EDGE_SIDE * h0 / w0))
    else:
        w, h = max(1, round(EDGE_SIDE * w0 / h0)), EDGE_SIDE
    edge = path + ".edges.png"
    magick(path + "[0]", "-resize", f"{w}x{h}!", "-write", "mpr:s",
           "-colorspace", "gray", "-canny", "0x2+10%+30%",
           "(", "mpr:s", "-colorspace", "HSL", "-channel", "G", "-separate",
           "+channel", "-canny", "0x2+10%+30%", ")",
           "-compose", "Lighten", "-composite", edge)
    thr = max(20, round(min(w, h) * 0.12))
    out = run(["magick", edge, "-hough-lines", f"15x15+{thr}", "mvg:-"])
    # a hit is an edge pixel within 2 px of the line: dilate once, look up
    E = subprocess.run(["magick", edge, "-morphology", "Dilate", "Square:2",
                        "-depth", "8", "gray:-"],
                       check=True, capture_output=True).stdout
    os.unlink(edge)
    lines = []
    for l in out.splitlines():
        m = re.match(r"line ([-\d.]+),([-\d.]+) ([-\d.]+),([-\d.]+)\s+# (\d+)", l)
        if not m:
            continue
        x1, y1, x2, y2 = (float(v) for v in m.groups()[:4])
        n = math.hypot(x2 - x1, y2 - y1)
        if n < 1:
            continue
        dx, dy = (x2 - x1) / n, (y2 - y1) / n
        # the line's hits, one sample per px along it, as prefix sums: the
        # support of any stretch of it is then two lookups
        span = int(math.hypot(w, h)) + 2
        pre = [0] * (2 * span + 2)
        for k in range(-span, span + 1):
            x, y = round(x1 + dx * k), round(y1 + dy * k)
            hit = 1 if 0 <= x < w and 0 <= y < h and E[y * w + x] > 128 else 0
            pre[k + span + 1] = pre[k + span] + hit
        lines.append({"l": (x1, y1, dx, dy), "cnt": int(m.group(5)),
                      "pre": pre, "span": span})

    def support(ln, a, b):
        x1, y1, dx, dy = ln["l"]
        ta = (a[0] - x1) * dx + (a[1] - y1) * dy
        tb = (b[0] - x1) * dx + (b[1] - y1) * dy
        if ta > tb:
            ta, tb = tb, ta
        s = ln["span"]
        i0 = max(0, min(2 * s + 1, round(ta) + s))
        i1 = max(0, min(2 * s + 1, round(tb) + s + 1))
        return (ln["pre"][i1] - ln["pre"][i0]) / max(1, i1 - i0)

    horiz = sorted((l for l in lines if abs(l["l"][2]) >= abs(l["l"][3])),
                   key=lambda l: -l["cnt"])[:EDGE_LINES]
    vert = sorted((l for l in lines if abs(l["l"][2]) < abs(l["l"][3])),
                  key=lambda l: -l["cnt"])[:EDGE_LINES]
    cands = []
    for i, t in enumerate(horiz):
        for b in horiz[i + 1:]:
            for j, le in enumerate(vert):
                for r in vert[j + 1:]:
                    q = [_cross(t["l"], le["l"]), _cross(t["l"], r["l"]),
                         _cross(b["l"], r["l"]), _cross(b["l"], le["l"])]
                    if None in q:
                        continue
                    sides = [(t, 0, 1), (r, 1, 2), (b, 2, 3), (le, 3, 0)]
                    # order the corners tl,tr,br,bl whichever line is which
                    cx = sum(p[0] for p in q) / 4
                    cy = sum(p[1] for p in q) / 4
                    if any(p[0] < -0.05 * w or p[0] > 1.05 * w or
                           p[1] < -0.05 * h or p[1] > 1.05 * h for p in q):
                        continue
                    area = _shoelace(q)
                    if area < 0.05 * w * h:
                        continue
                    if any(not 50 <= _angle(q[(k - 1) % 4], q[k], q[(k + 1) % 4]) <= 130
                           for k in range(4)):
                        continue
                    sup = [support(ln, q[a], q[c]) for ln, a, c in sides]
                    if min(sup) < EDGE_SUPPORT:
                        continue
                    order = sorted(range(4), key=lambda k: math.atan2(q[k][1] - cy, q[k][0] - cx))
                    qq = [q[k] for k in order]
                    k0 = min(range(4), key=lambda k: qq[k][0] + qq[k][1])
                    qq = qq[k0:] + qq[:k0]
                    share = area / (w * h)
                    cands.append({"quad": qq, "minsup": min(sup),
                                  "score": sum(sup) / 4 * math.sqrt(share),
                                  "share": share})
    cands.sort(key=lambda c: -c["score"])
    return cands, (lines, support), w, h, w0, h0


def _quad_sides(q):
    d = lambda a, b: math.hypot(a[0] - b[0], a[1] - b[1])
    return (d(q[0], q[1]) + d(q[3], q[2])) / 2, (d(q[0], q[3]) + d(q[1], q[2])) / 2


def edge_fold(q, lines, support):
    """The fold across an edge-found spread: (f1, f2, axis) or None.

    A spread's outline is a sheet's outline; what makes it two pages is a
    line across the middle, parallel to the short sides -- the fold, and on a
    Russian passport the red perforation strip right beside it. Among the
    lines, the one meeting both long sides between 35% and 65% of their
    length, parallel to the short sides within 12 degrees, and edge along
    FOLD_SUPPORT of its length or more.

    And it must stand ALONE. A card or a page of print has a line like that
    under every row of text: measured, 6-14 of them spread over the middle
    third, against exactly 2 on every real spread -- the two edges of the
    red strip, within 0.02 of each other. So every strong line has to lie
    within FOLD_SPREAD of the best one, and there may be no more than three.
    """
    wd, ht = _quad_sides(q)
    tl, tr, br, bl = q
    if ht >= wd:     # pages stacked: the fold runs across, left to right
        long_a, long_b, axis = (tl, bl), (tr, br), "v"
        ref = (tl[0], tl[1], tr[0] - tl[0], tr[1] - tl[1])
    else:            # side by side: the fold runs down
        long_a, long_b, axis = (tl, tr), (bl, br), "h"
        ref = (tl[0], tl[1], bl[0] - tl[0], bl[1] - tl[1])
    n = math.hypot(ref[2], ref[3])
    ref = (ref[0], ref[1], ref[2] / n, ref[3] / n)
    strong = []
    for ln in lines:
        l = ln["l"]
        if _line_angle(l, ref) > 12:
            continue
        pts, ts = [], []
        for P, Q in (long_a, long_b):
            L = math.hypot(Q[0] - P[0], Q[1] - P[1])
            side = (P[0], P[1], (Q[0] - P[0]) / L, (Q[1] - P[1]) / L)
            c = _cross(l, side)
            if c is None:
                break
            t = ((c[0] - P[0]) * side[2] + (c[1] - P[1]) * side[3]) / L
            if not 0.35 <= t <= 0.65:
                break
            pts.append(c); ts.append(t)
        if len(pts) != 2:
            continue
        sup = support(ln, pts[0], pts[1])
        if sup >= FOLD_SUPPORT:
            strong.append((sup, sum(ts) / 2, pts[0], pts[1]))
    if not strong:
        return None
    strong.sort(key=lambda x: -x[0])
    best = strong[0]
    # "strong" is relative to the best line: the Debian ImageMagick build's
    # Canny adds five weaker lines at 0.61-0.68 to a spread whose strip edges
    # measure 1.00, where the Alpine build found only the strip.
    strong = [x for x in strong if x[0] >= best[0] - FOLD_MARGIN]
    if len(strong) > 3:
        return None
    if any(abs(x[1] - best[1]) > FOLD_SPREAD for x in strong):
        return None
    return best[2], best[3], axis


FOLD_SUPPORT = 0.6      # share of the fold line that must be edge
FOLD_MARGIN = 0.25      # a line this much weaker than the best one is not
                        # a rival for the fold
FOLD_SPREAD = 0.03      # every strong line within this share of the long
                        # side of the best one, or it is rows of text
EDGE_SHEET_ASPECT = (1.25, 1.6)
EDGE_SHEET_MAX = 0.85   # of the frame: a larger sheet is the trim's job
EDGE_BRIGHT_FRAME = 0.7 # a brightness quad this much of the frame is the
                        # frame, not a document
EDGE_GROWTH = 1.3       # an edge outline must be this much larger than the
                        # brightness quad it contains to replace it


def _inside(p, q, slack):
    """Is point p inside the convex quad q, grown by `slack` px?"""
    for i in range(4):
        a, b = q[i], q[(i + 1) % 4]
        cross = (b[0] - a[0]) * (p[1] - a[1]) - (b[1] - a[1]) * (p[0] - a[0])
        if cross < -slack * math.hypot(b[0] - a[0], b[1] - a[1]):
            return False
    return True


def edge_document(src, bright_quad, o, report):
    """What the edges say the document is, when brightness said nothing useful.

    Returns ("cards", [quad], why), ("spread", [qa, qb], axis, why),
    ("sheet", quad, why) or None, quads in full-resolution pixels.

    The edge outline is trusted only where brightness failed: when it found
    no sheet at all, or a scrap lying inside the outline and much smaller
    than it (a child's book whose illustrations broke the paper mask). A
    card-shaped outline goes to the card path, which still wants a face
    photo on the card or its partner before it lays anything out as a card.
    """
    cands, (lines, support), w, h, w0, h0 = edge_quads(src)
    if not cands:
        return None
    best = cands[0]
    q = best["quad"]
    sx, sy = w0 / w, h0 / h
    full = lambda qq: [(p[0] * sx, p[1] * sy) for p in qq]
    wd, ht = _quad_sides(q)
    aspect = max(wd, ht) / max(1e-6, min(wd, ht))
    why = (f"found by its edges: {best['share']:.0%} of the frame, sides "
           f"{aspect:.2f}:1, outline {best['minsup']:.0%}+ edge")
    if o.cards != "off" and CARD_ASPECT[0] <= aspect <= CARD_ASPECT[1]:
        return ("cards", [full(q)], why)
    only_spread = False
    if bright_quad is not None:
        bq = [(p[0] / sx, p[1] / sy) for p in bright_quad]
        slack = 0.02 * max(w, h)
        if (all(_inside(p, q, slack) for p in bq)
                and _shoelace(q) >= EDGE_GROWTH * _shoelace(bq)):
            why += ", the brightness quad was a scrap inside it"
        elif ((all(_inside(p, bq, slack) for p in q)
                and _shoelace(bq) >= EDGE_GROWTH * _shoelace(q))
                or _shoelace(bq) >= EDGE_BRIGHT_FRAME * w * h):
            # the other way round: brightness took the pages together with
            # a light background -- or simply the frame, three quarters of
            # it and more, which says nothing about where the document is. Only a fold is evidence enough to believe
            # the outline over it -- a bare rectangle inside a region could
            # as well be a table printed on the page.
            why += ", the brightness quad took the background with it"
            only_spread = True
        else:
            return None
    if o.spread != "off":
        fold = edge_fold(q, lines, support)
        if fold:
            f1, f2, axis = fold
            tl, tr, br, bl = q
            qa, qb = (([tl, tr, f2, f1], [f1, f2, br, bl]) if axis == "v"
                      else ([tl, f1, f2, bl], [f1, tr, br, f2]))
            ok = True
            for pq in (qa, qb):
                pw, ph = _quad_sides(pq)
                if not 1.15 <= max(pw, ph) / max(1e-6, min(pw, ph)) <= 1.75:
                    ok = False
            if ok:
                return ("spread", [full(qa), full(qb)], axis,
                        why + ", a fold across the middle")
    # A sheet nearly filling the frame is what the border trim is for; its
    # outline hugs the photo's own border, where vignetting and JPEG seams
    # draw straight lines too (the public letter came out with a strip of
    # desk across its top).
    # ...and it must be shaped like a sheet: A4 1.41, Letter 1.29, a
    # passport page 1.42. A square of railings around a card in a hand
    # measured 1.05 and cut the card's bottom off.
    if (not only_spread and best["minsup"] >= EDGE_SHEET
            and 0.15 <= best["share"] <= EDGE_SHEET_MAX
            and EDGE_SHEET_ASPECT[0] <= aspect <= EDGE_SHEET_ASPECT[1]):
        return ("sheet", full(q), why)
    return None


def rectify(src, dst, quad, inset_pct, cap=None, cap_turns=False, size=None):
    """Warp the quad onto a rectangle whose sides average the quad's own.

    `cap` is the page the result will be laid onto. Rectifying to more pixels
    than the page can hold, only to resize them away at the end, is work with
    no reader: the fit scales by min(pw/W, ph/H), so everything above that is
    thrown out. Warping straight to the page is cheaper AND slightly sharper --
    one resample instead of two.

    `size` forces the rectangle instead: the two pages of a spread are one
    size in reality, whatever the perspective made of them.
    """
    tl, tr, br, bl = quad
    d = lambda a, b: math.hypot(a[0]-b[0], a[1]-b[1])
    W = max(50, round((d(tl, tr) + d(bl, br)) / 2))
    H = max(50, round((d(tl, bl) + d(tr, br)) / 2))
    if size:
        W, H = size
    elif cap:
        # The page turns to match a wide sheet, so cap against the page in THAT
        # orientation. Capping a landscape quad against a portrait page shaves
        # it to 2480 px wide and the fit then blows it back up to 3508 -- a
        # soft page produced by throwing detail away and inventing it again.
        if cap_turns and (W > H) != (cap[0] > cap[1]):
            cap = (cap[1], cap[0])
        k = min(1.0, cap[0] / W, cap[1] / H)
        if k < 1.0:
            W, H = max(50, round(W * k)), max(50, round(H * k))
    cx = sum(p[0] for p in quad) / 4; cy = sum(p[1] for p in quad) / 4
    f = inset_pct / 100.0
    q = [(p[0] + (cx - p[0]) * f, p[1] + (cy - p[1]) * f) for p in quad]
    pairs = "  ".join(f"{p[0]:.1f},{p[1]:.1f} {dx},{dy}" for p, (dx, dy) in
                      zip(q, ((0, 0), (W, 0), (W, H), (0, H))))
    # Triangle, not the default EWA filter: on a 2.4x downscale it costs 22%
    # less and lands within RMSE 0.002 of it.
    # The viewport is spelled out: without it the output canvas is the INPUT's
    # canvas, and a rectangle taller or wider than the photo it came from --
    # a spread page, a sheet shot from close up -- was silently cut to it.
    magick(src, "-filter", "Triangle",
           "-virtual-pixel", "white",
           "-define", f"distort:viewport={W}x{H}+0+0",
           "-distort", "Perspective", pairs,
           "-crop", f"{W}x{H}+0+0", "+repage", dst)
    return W, H


# The definition of "printed structure", used by _marks_map below. These are
# not tuning knobs — they are what the measure MEANS — so they are constants,
# not flags. The two decisions they feed (--band-structure, --band-dark) are.
BAND_MARK_DISK = 0.35   # % of the short side: wide enough to swallow a glyph
                        # stroke, far too small to swallow a binding ring
BAND_MARK_DELTA = 35    # % darker than its own local background a mark must be
BAND_MARK_BED = 55      # % of the paper level that background must still keep


def _marks_map(path, w, h, paper):
    """Per-cell density (0-255) of PRINTED marks, on the flood's own grid.

    A mark is a pixel darker than its OWN local background, where the local
    background is the image closed with a disk wide enough to swallow a glyph
    stroke but far too small to swallow a desk band or a binding ring. So a
    uniform thing that leans in from outside the sheet contributes nothing,
    while text printed on a shaded panel contributes its own coverage.

    The "the background must still be paper-bright" clause is what keeps the
    ragged rim of a dark binding ring out of the count: a rim sits on a dark
    bed, a glyph sits on a light one. Without it a real spiral binding measured
    4.6% structure against 5.1% for a shaded form panel — no gap at all.
    """
    disk = max(3, round(min(dims(path)) * BAND_MARK_DISK / 100.0))
    bed = round(paper * BAND_MARK_BED / 255.0, 1)
    # This closing is the most expensive single operation in the run: 2.4 s of
    # a 32 s page on the service's two cores, because a Disk kernel is dense --
    # radius 7 is a 15x15 window, 225 comparisons per pixel per pass.
    # Dilation composes, though, so the same octagonal disk is reachable by
    # growing twice with a diamond and once with a square, in the 5:2 ratio
    # that approximates a circle: 2.4 s -> 1.7 s on the service's build, and
    # 1.9x on builds without its vectorised dense path. The approximation gets
    # BETTER as the radius grows (RMSE 0.004 at radius 7, 0.002 at 14), so the
    # big pages that gain the most lose the least, and every page of this
    # corpus came out byte-identical with every border decision unchanged.
    #
    # Two cheaper things were tried and are NOT here. Measuring the marks on a
    # downscaled copy breaks the measure outright, whatever the filter or the
    # factor: at half scale a document edge carrying 35.5% structure read 0.0%
    # and got guillotined. And dropping the erode half (2.4 s -> 0.8 s, very
    # tempting) leaves the whole spiral binding standing on the page -- the
    # exact defect the band cut exists to remove.
    d_it = max(1, (disk * 5 + 7) // 14)
    s_it = max(0, disk - 2 * d_it)
    grow = ["-morphology", "Dilate:2", f"Diamond:{d_it}"]
    shrink = ["-morphology", "Erode:2", f"Diamond:{d_it}"]
    if s_it > 0:
        grow += ["-morphology", "Dilate:1", f"Square:{s_it}"]
        shrink = ["-morphology", "Erode:1", f"Square:{s_it}"] + shrink
    return subprocess.run(
        ["magick", str(path), "-colorspace", "gray",
         "(", "+clone", *grow, *shrink, ")",
         "(", "-clone", "0", "-clone", "1", "-compose", "Difference",
         "-composite", "-threshold", f"{BAND_MARK_DELTA}%", ")",
         "(", "-clone", "1", "-threshold", f"{bed}%", ")",
         "-delete", "0,1", "-compose", "Multiply", "-composite",
         "-morphology", "Open", "Octagon:1",
         "-resize", f"{w}x{h}!", "-depth", "8", "gray:-"],
        check=True, capture_output=True).stdout


SIDES = ("left", "right", "top", "bottom")

# What makes a spiral binding a spiral binding, as opposed to print that
# happens to reach the edge of the sheet: it is a row of EQUAL blobs at an
# EQUAL pitch. Nothing printed is that regular along a whole side. These are
# what the measure MEANS, not tuning knobs, so they are constants.
RING_MIN = 6            # rings; fewer is a smudge, not a binding
RING_COVER = (25, 75)   # % of the side the rings occupy -- fat blobs with
                        # paper between them, not a solid band and not a
                        # scatter of specks
RING_SPREAD = 0.35      # how much ring and gap lengths may vary, as a
                        # coefficient of variation


def _is_binding(prof):
    """Does this side's flood look like a row of binding rings?

    `prof` is how much of the band each line across the side carries. Measured
    on real pages: a spiral reads a spread of 0.06-0.26 over 17-34 rings
    covering half the side, while every printed edge that had to be KEPT reads
    0.41 and up, or has one or two blobs and no pitch at all. The two
    populations are nowhere near each other, which is the whole reason to
    measure the pattern rather than put a bar between two darkness numbers.
    """
    if not prof:
        return False
    peak = max(prof)
    if peak <= 0:
        return False
    thr = max(1, peak * 0.2)
    binv = [1 if c >= thr else 0 for c in prof]
    cover = 100.0 * sum(binv) / len(binv)
    if not (RING_COVER[0] <= cover <= RING_COVER[1]):
        return False
    runs, gaps, cur, prev = [], [], 0, 0
    for b in binv:
        if b != prev:
            (runs if prev else gaps).append(cur)
            cur = 0
        cur += 1
        prev = b
    (runs if prev else gaps).append(cur)
    # The first and last gap are the page ending, not a gap between rings.
    if len(gaps) > 2:
        gaps = gaps[1:-1]
    if len(runs) < RING_MIN or len(gaps) < RING_MIN - 1:
        return False

    def spread(v):
        m = sum(v) / len(v)
        if m <= 0:
            return 99.9
        return (sum((x - m) ** 2 for x in v) / len(v)) ** 0.5 / m

    return spread(runs) <= RING_SPREAD and spread(gaps) <= RING_SPREAD


def clean_border(path, dst, band_pct, keep_pct, struct_pct, dark_pct,
                 max_share=25.0, side=520):
    """Erase whatever leans in from outside the sheet, without cropping.

    Non-paper pixels that are CONNECTED TO THE FRAME EDGE are desk, shadow or a
    spiral binding: the sheet's own content cannot reach the border after a
    rectify. So flood from the border through the non-paper mask and repaint
    what it reaches in the page's own paper tone.

    Cropping bands instead is what the first attempt did, and it cut the first
    line of writing off the top and the list dashes off the left: near a margin,
    a line of text is just as "dark" as a binding. Connectivity is the property
    that actually separates the two. The flood is depth-capped so a stroke that
    does touch the edge cannot drain the whole page.

    Connectivity alone is still not enough, and that is the second bug this
    function has had. A printed form carries grey shaded panels, and a panel
    that reaches the edge of the sheet is BOTH darker than the paper AND touching
    the border, so it is flooded, repainted, and then guillotined together with
    the print sitting on it — that is how page 3 of a real four-page job lost its
    whole left column, every line ending mid-word. So each side of the
    flood is now judged before it is acted on: a side whose flooded pixels carry
    printed structure, or are only mildly darker than the paper, is part of the
    DOCUMENT. Such a side is never cropped, and the flood there is pulled back
    to a shallow `keep_pct` strip — enough for an edge fringe, far too little to
    eat a panel. When the two tests disagree the content wins: a slightly dirty
    edge is a far better failure than amputated text.
    """
    w0, h0 = dims(path)
    w = side
    h = max(1, round(side * h0 / w0))
    buf = raw_rgb(path, w, h)
    n = w * h
    V = bytearray(n); C = bytearray(n)
    for i in range(n):
        j = i * 3
        r, g, b = buf[j], buf[j+1], buf[j+2]
        v = r if r > g else g
        if b > v: v = b
        m = r if r < g else g
        if b < m: m = b
        V[i] = v; C[i] = v - m
    paper = sorted(V)[int(0.90 * (n - 1))]
    v_bad = int(paper * 0.88)   # the desk fades into a gradient at the
                                # sheet edge; catching only its darkest
                                # core leaves a visible tan fringe
    depth = max(3, int(min(w, h) * band_pct / 100.0))

    reach = bytearray(n)
    q = collections.deque()
    for x in range(w):
        for y in (0, h - 1):
            i = y * w + x
            if (V[i] < v_bad or C[i] > 45) and not reach[i]:
                reach[i] = 1; q.append((i, 0))
    for y in range(h):
        for x in (0, w - 1):
            i = y * w + x
            if (V[i] < v_bad or C[i] > 45) and not reach[i]:
                reach[i] = 1; q.append((i, 0))
    # `jump` lets the flood cross a narrow bright gap. A spiral binding is dark
    # rings with paper showing between them, so a strictly 4-connected flood
    # stops at the first gap and leaves the rest of the binding stranded inside
    # the page. The jump is small on purpose: it spreads only from something
    # already connected to the frame edge, never from ink.
    jump = 2
    off = [(dx, dy) for dy in range(-jump, jump + 1)
           for dx in range(-jump, jump + 1) if dx or dy]
    while q:
        i, d = q.popleft()
        if d >= depth:
            continue
        x, y = i % w, i // w
        for dx, dy in off:
            xx, yy = x + dx, y + dy
            if 0 <= xx < w and 0 <= yy < h:
                j2 = yy * w + xx
                if not reach[j2] and (V[j2] < v_bad or C[j2] > 45):
                    reach[j2] = 1; q.append((j2, d + 1))
    if not any(reach):
        return None, 0.0, {}, {}

    # Judge each side of the flood before acting on it. Every flooded pixel
    # belongs to the border it is nearest to, and for that group two numbers
    # are measured: how much printed structure it carries, and how dark it is
    # compared with the page's own paper level.
    marks = _marks_map(path, w, h, paper)
    tot = {k: [0, 0, 0] for k in SIDES}
    # How much of the band each line ACROSS a side carries -- down the page for
    # the left and right sides, across it for the top and bottom. This is the
    # shape `_is_binding` reads, and it costs nothing extra: the loop that owns
    # every flooded pixel is already here.
    prof = {k: [0] * (h if k in ("left", "right") else w) for k in SIDES}
    owner = bytearray(n)
    for i in range(n):
        if not reach[i]:
            continue
        x, y = i % w, i // w
        dist = (x, w - 1 - x, y, h - 1 - y)
        k = dist.index(min(dist))
        owner[i] = k + 1
        name = SIDES[k]
        t = tot[name]
        t[0] += marks[i]; t[1] += 1; t[2] += V[i]
        prof[name][y if k < 2 else x] += 1
    verdict = {}
    for k in SIDES:
        mk, cnt, vs = tot[k]
        st = 100.0 * mk / (255.0 * cnt) if cnt else 0.0
        dk = 100.0 * vs / (cnt * paper) if cnt and paper else 0.0
        # A binding ring carries a bright specular glint, and the dark rim
        # around that glint reads as a mark on a paper-bright bed, so a spiral
        # binding DOES register printed structure -- 11.3% on one notebook
        # page, 18.2% on a sharper photograph of the same notebook. There is no
        # bar to put it under: on that sharper page the BOTTOM edge, which is
        # handwriting and must be kept, measured 18.5%. Darkness does not
        # settle it either -- a real form's top band is just as dark (40% of
        # the paper level) and is nothing but print.
        #
        # So the pattern decides. Rings are a row of equal blobs at an equal
        # pitch, and nothing a printer puts on a page is. The test can only
        # take a side AWAY from the content, never give one to it, and it is
        # not consulted for a band the darkness test already cleared.
        doc = st > struct_pct or dk > dark_pct
        if doc and dk <= dark_pct and _is_binding(prof[k]):
            doc = False
        verdict[k] = (st, dk, doc, cnt)

    # A side that is part of the document keeps everything past a shallow strip.
    keep = max(2, int(min(w, h) * keep_pct / 100.0))
    for i in range(n):
        k = owner[i]
        if not k or not verdict[SIDES[k - 1]][2]:
            continue
        x, y = i % w, i // w
        if (x, w - 1 - x, y, h - 1 - y)[k - 1] > keep:
            reach[i] = 0

    share = 100.0 * sum(reach) / n
    if share <= 0.0:
        return None, 0.0, {}, verdict
    if share > max_share:
        return None, share, {}, verdict

    # A binding is a THICK band of border-connected junk, and the flood only
    # partly bites into it: the paper gaps between the spiral rings stop it. So
    # measure the band in the flood mask itself and crop that depth away. The
    # mask can only hold border-connected pixels, so a dash in the margin can
    # never be in it — which is exactly what the earlier darkness-based crop got
    # wrong when it ate the first line and the list dashes.
    cov_need = 0.15
    cut = {}
    for name in SIDES:
        last = 0
        if verdict[name][2]:
            # printed structure, or barely darker than paper: this band is the
            # document, not something leaning in from outside it. Never cut it.
            cut[name] = 0
            continue
        if name in ("left", "right"):
            rng = range(depth) if name == "left" else range(w - 1, w - 1 - depth, -1)
            for k, x in enumerate(rng):
                if sum(reach[y * w + x] for y in range(h)) / h > cov_need:
                    last = k + 1
            cut[name] = round(last * w0 / w)
        else:
            rng = range(depth) if name == "top" else range(h - 1, h - 1 - depth, -1)
            for k, y in enumerate(rng):
                row = y * w
                if sum(reach[row + x] for x in range(w)) / w > cov_need:
                    last = k + 1
            cut[name] = round(last * h0 / h)

    pgm = f"P5\n{w} {h}\n255\n".encode() + bytes(255 if v else 0 for v in reach)
    mpath = dst + ".bordermask.pgm"
    open(mpath, "wb").write(pgm)
    # the page's own paper tone, so the later flat-field sees no bright patch
    tone = fmt(path, "%[pixel:p{" + f"{w0 // 2},{h0 // 2}" + "}]")
    magick(path, "(", "-size", f"{w0}x{h0}", f"xc:{tone}", ")",
           "(", mpath, "-morphology", "Dilate", "Disk:3",
           "-resize", f"{w0}x{h0}!", "-blur", "0x2", ")",
           "-compose", "Over", "-composite", dst)
    os.unlink(mpath)
    return dst, share, cut, verdict


FINGER_CHROMA = 45      # the paper mask's own chroma limit
FINGER_RED = 30         # skin: red leads both other channels by this much
FINGER_DEPTH = 15.0     # % of the short side a finger may reach in
FINGER_OVER = 25        # skin is this much more saturated than the median
FINGER_MAX = 6.0        # % of the spread; a larger "finger" is the page
SPINE_BAND = 8.0        # % of the spread width kept clear around the spine


def erase_fingers(path, dst, axis, side=520):
    """Repaint a finger holding the booklet open, in its page's own tone.

    `axis` is the spread's ("h" pages side by side, "v" stacked), or None for
    a card: no spine to spare, and one tone for the whole piece.

    The hand that holds a spread open lies over its OUTER edge, and it is not
    something `clean_border` can take: a thumb is as bright as the paper, so
    the side it sits on is judged a shaded part of the document and kept. What
    gives it away is colour -- skin is red-led and far more saturated than
    paper (chroma 55-71 against 8-42 on a pink passport page).

    But so is the passport's red perforation strip, to within a few units
    (198,133,134 against 207,137,132), and the strip runs the whole height of
    the spine, touching the border at both ends. Colour cannot tell them
    apart; position can. A booklet is held at its outer edges, and the strip
    lives on the spine, so the band around the spine is never flooded.
    """
    w0, h0 = dims(path)
    w = side
    h = max(1, round(side * h0 / w0))
    buf = raw_rgb(path, w, h)
    n = w * h
    V = bytearray(n); C = bytearray(n); skin = bytearray(n)
    for i in range(n):
        j = i * 3
        r, g, b = buf[j], buf[j + 1], buf[j + 2]
        v = max(r, g, b)
        V[i] = v
        C[i] = v - min(r, g, b)
    # "Saturated" is relative to the pages themselves: under warm light a
    # whole page reads red-led and past the absolute limit, and a flood that
    # took it for skin repainted 36% of a spread, a third of the text with it.
    c_min = max(FINGER_CHROMA, sorted(C)[n // 2] + FINGER_OVER)
    for i in range(n):
        j = i * 3
        r, g, b = buf[j], buf[j + 1], buf[j + 2]
        if r == V[i] and C[i] > c_min and r - max(g, b) > FINGER_RED:
            skin[i] = 1
    paper = sorted(V)[int(0.90 * (n - 1))]
    for i in range(n):
        if skin[i] and V[i] < 0.55 * paper:
            skin[i] = 0
    if axis == "h":
        half = w * SPINE_BAND / 200.0
        spine = lambda x, y: abs(x - w / 2) < half
    elif axis == "v":
        half = h * SPINE_BAND / 200.0
        spine = lambda x, y: abs(y - h / 2) < half
    else:
        # a card has no spine: one piece, one tone
        spine = lambda x, y: False
    depth = max(3, int(min(w, h) * FINGER_DEPTH / 100.0))
    reach = bytearray(n)
    q = collections.deque()
    for x in range(w):
        for y in (0, h - 1):
            i = y * w + x
            if skin[i] and not spine(x, y) and not reach[i]:
                reach[i] = 1; q.append((i, 0))
    for y in range(h):
        for x in (0, w - 1):
            i = y * w + x
            if skin[i] and not spine(x, y) and not reach[i]:
                reach[i] = 1; q.append((i, 0))
    while q:
        i, d = q.popleft()
        if d >= depth:
            continue
        x, y = i % w, i // w
        for dx in (-1, 0, 1):
            for dy in (-1, 0, 1):
                xx, yy = x + dx, y + dy
                if 0 <= xx < w and 0 <= yy < h:
                    j2 = yy * w + xx
                    if skin[j2] and not reach[j2] and not spine(xx, yy):
                        reach[j2] = 1; q.append((j2, d + 1))
    share = 100.0 * sum(reach) / n
    if share < 0.05 or share > FINGER_MAX:
        # a finger is a few percent of a spread; far more than that is the
        # page's own colour, and repainting it would erase the page
        return None, share
    # each half of the spread is painted in its OWN paper tone: a pink page
    # patched with the white page's white would leave a white hole in it
    tones = []
    for k in range(2 if axis else 1):
        rs, gs, bs = [], [], []
        for y in range(h):
            for x in range(w):
                inside = (True if not axis else
                          (x < w / 2) if axis == "h" else (y < h / 2))
                i = y * w + x
                if inside == (k == 0) and not reach[i] and V[i] >= 0.8 * paper:
                    rs.append(buf[3 * i]); gs.append(buf[3 * i + 1]); bs.append(buf[3 * i + 2])
        med = lambda v: sorted(v)[len(v) // 2] if v else 255
        tones.append(f"rgb({med(rs)},{med(gs)},{med(bs)})")
    if not axis:
        tone_img = ["-size", f"{w0}x{h0}", f"xc:{tones[0]}"]
    elif axis == "h":
        tone_img = ["-size", f"{w0 // 2}x{h0}", f"xc:{tones[0]}",
                    "-size", f"{w0 - w0 // 2}x{h0}", f"xc:{tones[1]}", "+append"]
    else:
        tone_img = ["-size", f"{w0}x{h0 // 2}", f"xc:{tones[0]}",
                    "-size", f"{w0}x{h0 - h0 // 2}", f"xc:{tones[1]}", "-append"]
    mpath = dst + ".fingermask.pgm"
    open(mpath, "wb").write(f"P5\n{w} {h}\n255\n".encode()
                            + bytes(255 if v else 0 for v in reach))
    magick(path, "(", *tone_img, ")",
           "(", mpath, "-morphology", "Dilate", "Disk:2",
           "-resize", f"{w0}x{h0}!", "-blur", "0x2", ")",
           "-compose", "Over", "-composite", dst)
    os.unlink(mpath)
    return dst, share


# --------------------------------------------------------------- page pipeline


def rasterize(src, workdir, min_px=2400, tag="s00"):
    """Return a list of page rasters (PNG/JPG paths), best quality available."""
    ext = os.path.splitext(src)[1].lower()
    if ext != ".pdf":
        # -auto-orient rewrites the whole photo as a PNG. On a 12 MP phone shot
        # that is a third of a second spent to apply, usually, nothing: most
        # EXIF already says TopLeft. Read the tag first and hand the original
        # straight on when there is no rotation to bake in.
        if ext in (".jpg", ".jpeg", ".png"):
            try:
                if fmt(src, "%[orientation]") in ("Undefined", "TopLeft"):
                    return [src]
            except subprocess.CalledProcessError:
                pass
        out = os.path.join(workdir, f"{tag}-page-0.png")
        magick(src, "-auto-orient", out)
        return [out]

    info = run(["pdfinfo", str(src)])
    pages = int(re.search(r"^Pages:\s+(\d+)", info, re.M).group(1))

    # An embedded photo is better extracted than re-rendered: rendering applies
    # the ICC profile and can flatten the tonal range.
    listing = run(["pdfimages", "-list", str(src)]).strip().splitlines()[2:]
    one_per_page = len(listing) == pages
    if one_per_page:
        prefix = os.path.join(workdir, f"{tag}-img")
        run(["pdfimages", "-all", str(src), prefix])
        got = sorted(f for f in os.listdir(workdir) if f.startswith(f"{tag}-img-"))
        if len(got) == pages:
            out = []
            for i, f in enumerate(got):
                p = os.path.join(workdir, f)
                dst = os.path.join(workdir, f"{tag}-page-{i}.png")
                magick(p, "-auto-orient", dst)
                out.append(dst)
            return out

    prefix = os.path.join(workdir, f"{tag}-page")
    w = float(re.search(r"^Page size:\s+([\d.]+)", info, re.M).group(1))
    dpi = max(200, min(400, round(min_px / (w / 72.0))))
    run(["pdftoppm", "-r", str(dpi), "-png", str(src), prefix])
    return [os.path.join(workdir, f) for f in sorted(os.listdir(workdir))
            if f.startswith(f"{tag}-page") and f.endswith(".png")]


CARD_FACE_DARK = 0.30   # share of dark cells in the photo's place
CARD_FACE_RUN = 0.20    # share of its columns dark top to bottom for half
                        # its height -- hair, face, collar in one run, where
                        # lines of text leave gaps between them


def _place(cells, x0, x1, y0, y1):
    """(dark share, column share) of a place in a dark-cell map.

    The place is given as fractions of the image. Dark share: its cells that
    are darker than the paper near them. Column share: its columns that are
    dark top to bottom for half the place's height in one run -- a portrait
    is (hair, face, collar), lines of text are not (gaps between them).
    """
    dark, cw, ch, _, _ = cells
    xa, xb = int(x0 * cw), max(int(x0 * cw) + 1, int(x1 * cw))
    ya, yb = int(y0 * ch), max(int(y0 * ch) + 1, int(y1 * ch))
    cols = range(xa, min(cw, xb))
    if not cols:
        return 0.0, 0.0
    n = sum(dark[cy * cw + cx] for cy in range(ya, min(ch, yb)) for cx in cols)
    runs = 0
    for cx in cols:
        best = cur = 0
        for cy in range(ya, min(ch, yb)):
            cur = cur + 1 if dark[cy * cw + cx] else 0
            best = max(best, cur)
        runs += best >= 0.5 * (yb - ya)
    return n / (len(cols) * max(1, min(ch, yb) - ya)), runs / len(cols)


def card_face(path):
    """Where a card's face photo is: "left", "right", or None (a back).

    A card's front carries the holder's photo in a known place: the left
    third, most of the height (an ID card, a Russian or EU driving licence).
    So rather than search, the two places it can be -- as shot, and turned
    half round -- are measured and compared. A place holds a photo when its
    cells are dark against the card's paper near them (the same estimate as
    the page's face search, so a shadow larger than the photo is light, not
    ink) AND dark in unbroken columns: text has gaps between its lines, a
    portrait does not. Measured on eight rectified cards: fronts 0.38-0.62
    dark and 0.20-0.60 in columns on the photo side; backs 0.14-0.15 and 0.00
    on both sides. A hard shadow over the far side can pass too; then the
    darker, more columnar side wins, and a tie keeps the card as shot.
    """
    got = _dark_cells(path, 200)
    if got is None:
        return None
    (dl, rl), (dr, rr) = (_place(got, 0.03, 0.40, 0.10, 0.95),
                          _place(got, 0.60, 0.97, 0.10, 0.95))
    left = dl >= CARD_FACE_DARK and rl >= CARD_FACE_RUN
    right = dr >= CARD_FACE_DARK and rr >= CARD_FACE_RUN
    if left and right:
        diff = (dl + rl) - (dr + rr)
        return "left" if diff > -0.1 else "right"
    return "left" if left else "right" if right else None


def process_cards(src, quads, why, out_png, o, report):
    """Each card in the frame, rectified to its real size and turned upright.

    Returns a list of {"png", "front"}: the card at ID-1 size at --dpi, with
    rounded corners and a hairline edge, and whether its face photo was
    found. Laying them out is the caller's job, since a front and its back
    may come from two photographs.
    """
    cw_px = round(CARD_MM[0] / MM * o.dpi)
    ch_px = round(CARD_MM[1] / MM * o.dpi)
    radius = CARD_RADIUS_MM / MM * o.dpi
    cards = []
    d = lambda a, b: math.hypot(a[0] - b[0], a[1] - b[1])
    report.append(f"card: {len(quads)} ID-1 card{'s' if len(quads) > 1 else ''} "
                  f"in the frame ({why})")
    for k, q in enumerate(quads):
        wide = (d(q[0], q[1]) + d(q[3], q[2])) >= (d(q[0], q[3]) + d(q[1], q[2]))
        raw = f"{out_png}.card{k}-rect.png"
        rectify(src, raw, q, 0.0, size=(cw_px, ch_px) if wide else (ch_px, cw_px))
        turn = 0 if wide else 90
        if turn:
            magick(raw, "-rotate", "90", raw)
        # fingers hold a card at its edges: repainted before anything is
        # measured, so a thumb is not read as the face photo either
        got, share = erase_fingers(raw, raw + ".fingers.png", None)
        if got:
            raw = got
            report.append(f"card {k + 1}: erased a finger at the edge "
                          f"({share:.1f}% of the card)")
        side = card_face(raw)
        if side == "right":
            turn = (turn + 180) % 360
            magick(raw, "-rotate", "180", raw)
        front = side is not None
        # A colour copy, not a scan: a card's tint and its security print ARE
        # the document, so nothing is whitened. Only the light is evened --
        # the brightness divided by a very wide blur of itself, the same
        # factor on every channel so the colour stays -- then a gentle stretch
        # and the page's own sharpening.
        sig = round(cw_px / 5)
        fixed = f"{out_png}.card{k}.png"
        mean = float(fmt(raw, "%[fx:mean]")) or 0.5
        magick(raw, "(", "+clone", "-colorspace", "gray", "-blur", f"0x{sig}", ")",
               "(", "-clone", "0", "-evaluate", "multiply", f"{mean:.4f}", ")",
               "-delete", "0", "+swap", "-compose", op_divide(), "-composite",
               "-contrast-stretch", "0.3%x0.3%",
               "-unsharp", f"0x1+{o.sharpen}+0.02",
               # the rounded corners of ID-1, and a hairline so a white card
               # still has an edge on a white page
               "(", "-size", f"{cw_px}x{ch_px}", "xc:black", "-fill", "white",
               "-draw", f"roundrectangle 0,0 {cw_px - 1},{ch_px - 1} "
                        f"{radius:.1f},{radius:.1f}", ")",
               "-alpha", "off", "-compose", "CopyOpacity", "-composite",
               "-background", "white", "-compose", "Over", "-flatten",
               "-fill", "none", "-stroke", "gray70", "-strokewidth",
               str(max(1, round(o.dpi / 150))),
               "-draw", f"roundrectangle 0,0 {cw_px - 1},{ch_px - 1} "
                        f"{radius:.1f},{radius:.1f}",
               fixed)
        report.append(f"card {k + 1}: rectified to {cw_px}x{ch_px} "
                      f"({CARD_MM[0]:.1f}x{CARD_MM[1]:.2f} mm), turned {turn}°, "
                      + ("face photo on the left — front" if front else
                         "no face photo — back"))
        cards.append({"png": fixed, "front": front})
    return cards


def card_page(cards, out_png, o):
    """One A4 with a card's front above its back, at their real size.

    `--card-size fit` blows them up to the page width instead (each 180 mm
    wide), for a copy that has to be read rather than filed.
    """
    pw = round(210 / MM * o.dpi)
    ph = round(297 / MM * o.dpi)
    gap = round(15 / MM * o.dpi)
    if o.card_size == "fit":
        cw_px = round(180 / MM * o.dpi)
        ch_px = round(cw_px * CARD_MM[1] / CARD_MM[0])
    else:
        cw_px = round(CARD_MM[0] / MM * o.dpi)
        ch_px = round(CARD_MM[1] / MM * o.dpi)
    total = len(cards) * ch_px + (len(cards) - 1) * gap
    y = (ph - total) // 2
    x = (pw - cw_px) // 2
    args = ["-size", f"{pw}x{ph}", "xc:white"]
    for c in cards:
        args += ["(", c["png"], "-resize", f"{cw_px}x{ch_px}!", ")",
                 "-geometry", f"+{x}+{y}", "-compose", "Over", "-composite"]
        y += ch_px + gap
    magick(*args, "-colorspace", "sRGB", out_png)
    return out_png


def fit_photo_page(src, out_png, o, report):
    """The photo path: geometry, and nothing else. A single early return.

    The README promises that a frame holding no document is "fitted onto the
    page as shot", and it was not true: the stages were merely switched off one
    by one with `not photo` guards further down, and the paper-whitening Screen
    composite at the very end of the fit carried no guard at all. It threw every
    pixel above --paper-thr to pure white, which on a real photograph blew 6% of
    the frame out and dragged the colour balance with it (measured on a photo of
    a green screen: pure-white pixels 0.37% -> 5.96%, mean blue +4.4/255).

    So the photo path is not the document pipeline with flags off any more, it
    is this function, which returns before that pipeline begins. The only things
    that happen to the pixels are the resize onto the page and the JPEG encode
    the caller does at --photo-dpi / --photo-quality. Nothing can leak in later
    without being written here on purpose.
    """
    iw, ih = dims(src)
    page_dpi = o.photo_dpi
    pw = round(210 / MM * page_dpi)
    ph = round(297 / MM * page_dpi)
    # In photo mode the PAGE turns, not the picture: rotating a landscape
    # snapshot to fit a portrait page would stand its content on its side.
    turned = iw > ih * 1.05 and not o.landscape
    if o.landscape or turned:
        pw, ph = ph, pw
    scale = min(pw / iw, ph / ih)
    off = (round((pw - iw * scale) / 2), round((ph - ih * scale) / 2))
    scaled = f"{out_png}.photo-scaled.png"
    magick(src, "-resize", f"{scale * 100:.4f}%", scaled)
    magick("-size", f"{pw}x{ph}", "xc:white", scaled,
           "-geometry", f"{off[0]:+d}{off[1]:+d}", "-composite",
           "-colorspace", "sRGB", out_png)
    os.unlink(scaled)
    if o.gray:
        report.append("--gray ignored: the photo path does not touch colour")
    report.append(f"fit: frame (photo, {'landscape page' if turned else 'kept as shot'})"
                  f"; scale {scale:.4f}, offset {off[0]:+d}{off[1]:+d}")
    report.append(f"page: {pw}x{ph}px @ {page_dpi}dpi (no flat-field, no tone, "
                  f"no paper-whitening, no sharpen — passthrough)")
    return out_png, True, page_dpi


# Below this much real detail at the size the page lands, 300 dpi only stores
# invented pixels. 180 sits between the two public examples as measured: the
# notebook photo holds 111 dpi (a 200 dpi page loses nothing), the letter 208
# (kept at 300, where it has something to show).
LOWRES_DPI = 180.0


def photo_patch(keep, scale, off, o, out_png):
    """ImageMagick args that lay the gently toned face photo over the page.

    The photo keeps its own tones: black at its darkest half percent, white at
    its own light background (bounded by the page's paper level), so that
    background meets the white page and the face stays a face. A black-and-white photo is made properly grey, since the
    page's cast would otherwise tint it. Its edge is feathered over a few
    pixels so the seam to the treated page does not show.
    """
    src, (bx, by, bw, bh) = keep
    gray = raw_gray(src, 200, max(1, round(200 * dims(src)[1] / dims(src)[0])))
    paper = sorted(gray)[int(0.90 * (len(gray) - 1))]
    cw = 120
    chh = max(1, round(cw * bh / bw))
    crop = ["-crop", f"{bw}x{bh}+{bx}+{by}", "+repage"]
    g = subprocess.run(["magick", str(src), *crop, "-colorspace", "gray",
                        "-resize", f"{cw}x{chh}!", "-depth", "8", "gray:-"],
                       check=True, capture_output=True).stdout
    black = sorted(g)[int(0.005 * (len(g) - 1))]
    rgb = subprocess.run(["magick", str(src), *crop, "-resize", f"{cw}x{chh}!",
                          "-depth", "8", "rgb:-"],
                         check=True, capture_output=True).stdout
    # the MEDIAN chroma: a red ornament the box clips must not make a
    # black-and-white photo count as a colour one
    chroma = sorted(max(rgb[j:j + 3]) - min(rgb[j:j + 3])
                    for j in range(0, len(rgb), 3))[len(rgb) // 6]
    mono = o.gray or chroma < 12
    # White goes at the photo's own light background when it has one -- a
    # passport photo's card sits a few percent under the page's paper, and
    # leaving it there draws a grey rectangle on a white page -- but never
    # below 85% of the paper, or a dark photo would be blown out to find it.
    light = sorted(g)[int(0.85 * (len(g) - 1))]
    white = min(0.98 * paper, max(0.85 * paper, light))
    lo = 100.0 * black / 255
    hi = max(lo + 10, 100.0 * white / 255)
    pw_, ph_ = max(1, round(bw * scale)), max(1, round(bh * scale))
    feather = max(2, round(min(pw_, ph_) * 0.015))
    patch = out_png + ".photo.png"
    magick(src, *crop, *(["-colorspace", "gray"] if mono else []),
           "-level", f"{lo:.2f}%,{hi:.2f}%",
           "-resize", f"{pw_}x{ph_}!",
           "-unsharp", f"0x1+{o.sharpen}+0.02", "-colorspace", "sRGB",
           "(", "-size", f"{pw_}x{ph_}", "xc:black", "-fill", "white",
           "-draw", f"rectangle {2 * feather},{2 * feather} "
                    f"{pw_ - 1 - 2 * feather},{ph_ - 1 - 2 * feather}",
           "-blur", f"0x{feather}", ")",
           "-alpha", "off", "-compose", "CopyOpacity", "-composite", patch)
    x = off[0] + round(bx * scale)
    y = off[1] + round(by * scale)
    return [patch, "-geometry", f"{x:+d}{y:+d}", "-compose", "Over", "-composite"]


def process_page(src, out_png, o, report):
    # 0. document or photo? Decided BEFORE anything touches the pixels, because
    #    the photo path is a different pipeline, not this one with stages turned
    #    off. --photo on used to still run the rectify, which is exactly the
    #    kind of leak the early return exists to make impossible.
    quad, why, paper_share = None, None, 1.0
    spread = None
    if o.photo == "on":
        report.append("--photo on — kept as a photo, not scanned")
        return fit_photo_page(src, out_png, o, report)
    if o.rectify != "off":
        vc = _vc(src)
        pm = paper_mask(src, vc=vc)
        # A spread is tried FIRST: its two pages are also two perfectly good
        # sheet candidates, and the single-sheet rule would take the larger
        # one and drop its facing page without a word. The strict reading of
        # "paper" goes first, so a plain sheet is judged exactly as before;
        # the looser ones only get a say when it found no spread.
        if o.spread != "off":
            whys = []
            for mode in ("paper", "tinted", "otsu"):
                cand = pm if mode == "paper" else paper_mask(src, vc=vc, mode=mode)
                squads, axis, swhy = detect_spread(cand)
                if squads:
                    if mode != "paper":
                        swhy += f", {mode} paper mask"
                    spread = (squads, axis, swhy)
                    break
                whys.append(f"{mode}: {swhy}")
            if not spread and o.spread == "on":
                sys.exit("a4norm: --spread on, but no two facing pages found: "
                         + "; ".join(whys))
        # An ID-1 card. Two separate cards in one frame beat a spread -- two
        # card-shaped regions TOUCHING are refused as cards already, and left
        # to the spread -- but a lone card does not: a passport's page can
        # pass for one, while a lone card never passes for a spread.
        if o.cards != "off":
            cquads, cwhy = detect_cards(src, vc)
            # ...unless the "spread" IS the card: split in two at a kink a
            # glare put in its edge, its two halves are the card's area.
            # A card that is one page of a real spread covers half of it.
            if cquads and spread and len(cquads) == 1:
                sarea = sum(_shoelace(q) for q in spread[0])
                # ...and not much larger than it either: a card-shaped
                # outline around both pages is the open passport itself
                # (74% of a frame whose spread was 66%), and taking it as a
                # card cost a whole second run once no face was on it
                if CARD_OF_SPREAD * sarea <= _shoelace(cquads[0]) <= 1.25 * sarea:
                    spread = None
            if cquads and spread and len(cquads) == 1:
                cquads = None
            if cquads and (len(cquads) == 2 or not spread):
                if spread:
                    report.append(f"two cards, not a spread ({spread[2]})")
                return (process_cards(src, cquads, cwhy, out_png, o, report),
                        "cards", o.dpi)
    edge = None
    if o.rectify != "off" and not spread:
        quad, why, paper_share = detect_quad(src, pm=pm)
        # The document's edges, read as lines -- for what brightness cannot
        # see: a white page on a white desk, a pale card on white paint, a
        # page whose colour pictures broke the paper mask into a scrap.
        if o.edges != "off":
            edge = edge_document(src, quad, o, report)
            if edge and edge[0] == "cards":
                return (process_cards(src, edge[1], edge[2], out_png, o, report),
                        "cards", o.dpi)
            if edge and edge[0] == "spread":
                spread, quad = (edge[1], edge[2], edge[3]), None
            elif edge and edge[0] == "sheet":
                quad, why = edge[1], edge[2]
    if o.rectify != "off" and not spread:
        if quad is None:
            # Brightness could not find the sheet. Ask the segmentation helper,
            # if this build has one, and judge its answer by the same rules.
            # Only here, never on the common path: the model costs a second and
            # buys nothing when the page is already the brightest thing around.
            seg_quad, seg_why, seg_share = segment_quad(src)
            if seg_quad is not None:
                quad = seg_quad
                why = f"{seg_why}, found by segmentation after brightness failed ({why})"
                paper_share = max(paper_share, seg_share)
            elif "no segmentation helper" not in seg_why:
                report.append(f"segmentation did not find a sheet either: {seg_why}")
        if quad is None:
            if o.rectify == "on":
                sys.exit(f"a4norm: --rectify on, but no sheet quad found: {why}")
            report.append(f"no rectification: {why}")
            # No sheet quad AND almost no paper-like area means there is no
            # document in the frame — somebody is just turning photos into a
            # PDF. Scanner treatment would wreck that: it bleaches the picture,
            # straightens it by a few degrees off some accidental edge, and
            # lays it out as if it were a text block. Measured paper-like
            # area: 9% for a photo of a screen, 40-83% for every real document
            # and test page here — the threshold sits in a wide gap.
            if o.photo == "auto" and paper_share * 100 < o.photo_paper:
                report.append(f"no document in the frame (paper-like area "
                              f"{paper_share:.0%}, under --photo-paper "
                              f"{o.photo_paper:.0f}%) — kept as a photo, not "
                              f"scanned")
                return fit_photo_page(src, out_png, o, report)
            report.append(f"paper-like area {paper_share:.0%} >= --photo-paper "
                          f"{o.photo_paper:.0f}% — treated as a document")

    # ---- from here down it is a document. There is no `photo` flag any more.
    cur = src
    step = 0
    rectified = False

    def stage(name, *args, src_override=None):
        nonlocal cur, step
        step += 1
        dst = f"{out_png}.s{step}-{name}.png"
        magick(src_override or cur, *args, dst)
        cur = dst
        return dst

    # 1. rectify: warp the sheet's own quadrilateral onto a rectangle. This has
    #    to come first — every later step assumes the page is flat, and a page
    #    shot at an angle is the one thing a rectangular crop can never fix.
    if spread:
        squads, axis, swhy = spread
        d = lambda a, b: math.hypot(a[0] - b[0], a[1] - b[1])
        # Both pages are warped to ONE size, the mean of what the photo shows:
        # a booklet's pages are equal, and joining two rectangles of different
        # sizes along the spine would leave a step in the edge.
        pw_ = sum((d(q[0], q[1]) + d(q[3], q[2])) / 2 for q in squads) / 2
        ph_ = sum((d(q[0], q[3]) + d(q[1], q[2])) / 2 for q in squads) / 2
        sw, sh_ = (2 * pw_, ph_) if axis == "h" else (pw_, 2 * ph_)
        k = 1.0
        if o.fit == "auto":
            # the spread may turn a quarter, so cap it against the page
            # either way round: long side against long side
            cap = (round(210 / MM * o.dpi), round(297 / MM * o.dpi))
            k = min(1.0, max(cap) / max(sw, sh_), min(cap) / min(sw, sh_))
        W1, H1 = max(50, round(pw_ * k)), max(50, round(ph_ * k))
        halves = []
        for idx, q in enumerate(squads):
            step += 1
            dst = f"{out_png}.s{step}-page{idx + 1}.png"
            rectify(src, dst, q, o.rect_inset, size=(W1, H1))
            halves.append(dst)
        step += 1
        dst = f"{out_png}.s{step}-spread.png"
        magick(*halves, "+append" if axis == "h" else "-append", dst)
        cur = dst
        rectified = True
        W, H = dims(cur)
        report.append(f"spread: two facing pages ({swhy}), each rectified "
                      f"to {W1}x{H1} and joined at the fold -> {W}x{H}")
        step += 1
        got, share = erase_fingers(cur, f"{out_png}.s{step}-fingers.png", axis)
        if got:
            cur = got
            report.append(f"erased a finger at the outer edge ({share:.1f}% "
                          f"of the spread)")
        elif share > FINGER_MAX:
            report.append(f"finger erase skipped: what looked like skin was "
                          f"{share:.0f}% of the spread — the pages' own colour")
    elif quad:
        step += 1
        dst = f"{out_png}.s{step}-rectify.png"
        # Only for the default fit. --fit content and --fit edges derive their
        # scale from the layout, not from the frame, and may legitimately want
        # to blow the page up past 1:1; capping the warp would hand them fewer
        # pixels to blow up. The auto fit on a rectified page always scales by
        # min(pw/W, ph/H), so there the cap costs nothing and saves a resample.
        cap = None
        if o.fit == "auto":
            cap = (round(210 / MM * o.dpi), round(297 / MM * o.dpi))
            if o.landscape:
                cap = (cap[1], cap[0])
        W, H = rectify(src, dst, quad, o.rect_inset, cap=cap,
                       cap_turns=(o.rotate == "auto" and not o.landscape))
        cur = dst
        rectified = True
        report.append(f"rectified the sheet quad ({why}) -> {W}x{H}")
    if rectified:
        if not o.no_edge_clean:
            step += 1
            cleaned = f"{out_png}.s{step}-border.png"
            got, share, cut, verdict = clean_border(
                cur, cleaned, o.edge_band, o.edge_keep,
                o.band_structure, o.band_dark)
            kept = [f"{k} (structure {verdict[k][0]:.1f}%, "
                    f"brightness {verdict[k][1]:.0f}% of paper)"
                    for k in SIDES if verdict.get(k) and verdict[k][2]
                    and verdict[k][3]]
            if kept:
                report.append("kept as document, not erased or cut: "
                              + "; ".join(kept))
            if got:
                cur = got
                report.append(f"erased what leaned in from outside the "
                              f"sheet ({share:.1f}% of the page)")
                pad = round(max(W, H) * 0.004)
                l = cut["left"] + pad if cut["left"] else 0
                r = cut["right"] + pad if cut["right"] else 0
                t = cut["top"] + pad if cut["top"] else 0
                b = cut["bottom"] + pad if cut["bottom"] else 0
                if (l or r or t or b) and W - l - r > 100 and H - t - b > 100:
                    stage("binding", "-crop",
                          f"{W - l - r}x{H - t - b}+{l}+{t}", "+repage")
                    W, H = W - l - r, H - t - b
                    report.append(f"cut a solid band of it away: "
                                  f"L/R/T/B = {l}/{r}/{t}/{b} px")
                    # the crop exposes a fresh border: whatever the band was
                    # hiding is now the outermost pixel, so flood once more
                    step += 1
                    again = f"{out_png}.s{step}-border2.png"
                    got2, share2, _, _ = clean_border(
                        cur, again, o.edge_band, o.edge_keep,
                        o.band_structure, o.band_dark)
                    if got2:
                        cur = got2
                        report.append(f"second pass on the new border "
                                      f"({share2:.1f}%)")
            elif share:
                report.append(f"border cleanup skipped: it would have "
                              f"repainted {share:.0f}% of the page")

    # 2. rotate, but only when asked to. `--rotate auto` turns nothing: the
    #    PAGE follows the picture at the fit step below, exactly as it already
    #    does in photo mode. Turning the pixels instead assumes a wide frame
    #    means a sideways sheet, and it usually does not -- a square notebook
    #    page shot in a wide frame is wide because of the FRAME, and standing
    #    its lines on end makes it unreadable. A portrait sheet genuinely
    #    photographed sideways stays sideways, which the reader fixes with one
    #    keypress; unreadable text is not fixable at all.
    #    A spread is the exception, because there the evidence is on the page:
    #    which way its lines of text run, and which side its photo is on.
    if o.rotate not in ("auto", "0"):
        stage("rot", "-rotate", o.rotate)
        report.append(f"rotated {o.rotate}°")
    elif spread and o.rotate == "auto":
        turn = spread_turn(cur, spread[1], report)
        if turn:
            stage("rot", "-rotate", str(turn))
            report.append(f"rotated {turn}°")

    # 3. cut the photographic border (desk, shadow, sheet edge). Pointless
    #    after a rectify — the quad already ended exactly at the sheet.
    flags, span, shave = {}, {}, {"l": 0, "t": 0}
    if not o.no_trim and not rectified:
        dl, dr, dt, db, flags = detect_border(cur, o.trim_band / 100.0, o.trim_step)
        iw, ih = (int(x) for x in fmt(cur, "%w %h").split())
        # The detected step IS the sheet boundary, so the span between two
        # opposite steps is the real sheet size — remembered before shaving, so
        # the A4 scale stays exact even though a little paper is cut away.
        span = {"w": iw - dl - dr, "h": ih - dt - db}
        sh = max(o.trim_pad, round(o.trim_shave / 100.0 * min(iw, ih)))
        cut = {}
        for key, val, name in (("l", dl, "left"), ("r", dr, "right"),
                               ("t", dt, "top"), ("b", db, "bottom")):
            cut[key] = val + sh if flags[name] else 0
        shave = {"l": cut["l"] and sh, "t": cut["t"] and sh}
        if any(cut.values()):
            stage("trim", "-crop",
                  f"{iw - cut['l'] - cut['r']}x{ih - cut['t'] - cut['b']}"
                  f"+{cut['l']}+{cut['t']}", "+repage")
        report.append(
            "border cut L/R/T/B = %d/%d/%d/%d px (edge + %d px shave; edges: %s)"
            % (cut["l"], cut["r"], cut["t"], cut["b"], sh,
               ",".join(k for k, v in flags.items() if v) or "none"))

    # 4a. a face photo on the page is found BEFORE the flat-field touches it.
    #    Everything from here on is built to turn light smooth areas into white
    #    paper, and a face is a light smooth area: the background estimate
    #    follows it, the division lifts it to white, the haze and paper screens
    #    finish the job. What came out of a passport was a face with white
    #    holes for cheeks. So the photo is cut out of the page as it is now,
    #    toned gently on its own, and laid back over the finished page.
    keep = None
    if not o.no_keep_photo:
        if spread:
            # on a spread the photo is only ever on the lower page's left
            box = None
            iw_, ih_ = dims(cur)
            x1_, y0_ = round(iw_ * 0.45), round(ih_ * 0.5)
            part = f"{out_png}.photo-place.png"
            magick(cur, "-crop", f"{x1_}x{ih_ - y0_}+0+{y0_}", "+repage", part)
            # the place is a quarter of the spread, so the photo fills far
            # more of it than of a page: up to two thirds
            # In its known place the photo's known shape does the work the
            # fill test does elsewhere: a light portrait fills only 0.29 of
            # its box, while the narrow column of print beside it that won
            # instead is 0.40 wide for its height -- a photo's dark block,
            # hair to jacket, measured 0.48-1.69. The photo also fills a good
            # part of its place (a 1% scrap of print won once without a
            # floor). Three passes, strictest first: a sizeable block with
            # the ordinary fill; one with a light portrait's loose fill; and
            # a small one -- a child's face in pieces measured 5%.
            kw = dict(area_max=65.0, aspect=(0.45, 1.8))
            got = (find_photo_block(part, area_min=8.0, **kw)
                   or find_photo_block(part, area_min=8.0, fill=0.25, **kw)
                   or find_photo_block(part, area_min=3.0, **kw))
            os.unlink(part)
            if got:
                # The dark cells are the hair and the eyes; a light face and
                # a light collar below them were left to the paper treatment
                # and came out as white holes. A passport photo's size is
                # known -- 35 x 45 mm on a 88 x 125 mm page -- so the box is
                # grown to at least that height, down from the top of what
                # was found.
                bx, by, bw, bh = got[0], got[1] + y0_, got[2], got[3]
                pw_ = round(iw_ * SPREAD_PHOTO_MM[0] / 88.0)
                ph_ = round(ih_ / 2 * SPREAD_PHOTO_MM[1] / 125.0)
                # Only downward: where the dark block sits across is where
                # the photo is (widening it centred slid it onto the print
                # beside a photo whose hair lay to one side).
                if bw > 1.25 * pw_:
                    # the block ran on into the print beside the photo; the
                    # photo is the leftmost thing in its place
                    bw = round(1.1 * pw_)
                if bh < ph_:
                    bh = min(ph_, ih_ - by)
                box = (bx, by, bw, bh)
        else:
            box = find_photo_block(cur)
        if box:
            keep = (cur, box)
            pw0, ph0 = dims(cur)
            report.append(f"face photo at {box[2]}x{box[3]}+{box[0]}+{box[1]} "
                          f"of {pw0}x{ph0} — toned on its own, not flattened "
                          f"into the paper")

    # 4. flat-field: divide by a smoothed background estimate -> even white paper
    iw, ih = (int(x) for x in fmt(cur, "%w %h").split())
    # The background estimate is in COLOUR on purpose. A grey estimate divides
    # the paper's cast into itself and leaves it: cream paper stays cream, and
    # then its own tint on the ink reads as "coloured ink" and gets preserved,
    # which is how a black biro came out brown. A per-channel estimate white-
    # balances the sheet, so what survives in colour is really coloured.
    # The estimate is then squeezed to --bg-scale and blurred there, so no
    # detail finer than that survives it: closing at full resolution is six
    # times the work for a result within RMSE 0.01 of this one. So sample the
    # page down and scale the kernel with it -- the structure the close
    # swallows stays the same size in the ORIGINAL, which is what matters.
    # Measured 3.16s -> 0.53s on a 1644x2329 page. The divisor is bounded so
    # the kernel never drops below ~3: below that the close stops swallowing
    # strokes and the estimate darkens under the text, which showed up as
    # nearly three times the drift (RMSE 0.035 vs 0.012 across the corpus).
    bg_div = max(1, round(o.close / 3))
    bg_kern = max(1, round(o.close / bg_div))
    stage("flat",
              "(", "+clone",
              "-sample", f"{100.0 / bg_div:.4f}%",
              "-morphology", "Close", f"Octagon:{bg_kern}",
              "-resize", f"{o.bg_scale * bg_div:.4f}%", "-blur", "0x6",
              "-filter", "Triangle", "-resize", f"{iw}x{ih}!", "+filter", ")",
              "-compose", op_divide(), "-composite")

    # 5. deskew — AFTER the flat-field on purpose. The angle is measured on a
    #    binarized copy, and on a dim photo the whole sheet falls below the
    #    threshold and reads as one blob, so a real tilt is measured as 0.0deg.
    #    Once the paper is white, the text lines are what the estimator sees.
    if not o.no_deskew and not rectified:
        # After a rectify the quad IS the page orientation. Re-measuring it from
        # text baselines then fights it, and on handwriting the estimator has no
        # baselines worth trusting: it read +1.61 deg off an already-flat page.
        ang = deskew_angle(cur)
        if o.deskew_min <= abs(ang) <= 5.0:
            before = tuple(int(x) for x in fmt(cur, "%w %h").split())
            stage("deskew", "-background", "white", "-deskew", "40%")
            after = tuple(int(x) for x in fmt(cur, "%w %h").split())
            if span and after != before:
                # keep the sheet span in sync with the canvas the fit will use
                span["w"] = round(span["w"] * after[0] / before[0])
                span["h"] = round(span["h"] * after[1] / before[1])
            # Rotating swings the edges: a strip as wide as max_side * sin(angle)
            # that used to sit outside the frame now leans into it, dragging the
            # sliver of desk the pre-rotation shave did not reach. Cut it, and
            # book it as shave so the A4 anchor stays put.
            lean = math.ceil(max(after) * abs(math.sin(math.radians(ang))))
            if lean and any(flags.values()):
                iw2, ih2 = after
                cl = lean if flags.get("left") else 0
                cr = lean if flags.get("right") else 0
                ct = lean if flags.get("top") else 0
                cb = lean if flags.get("bottom") else 0
                if iw2 - cl - cr > 100 and ih2 - ct - cb > 100:
                    stage("lean", "-crop",
                          f"{iw2 - cl - cr}x{ih2 - ct - cb}+{cl}+{ct}", "+repage")
                    shave["l"] += cl
                    shave["t"] += ct
            report.append(f"deskewed {ang:+.2f}°, edge lean cut {lean}px")
            if keep:
                # the photo's box is in the coordinates of the page BEFORE the
                # turn; laying it back at those would misplace it
                keep = None
                report.append("face photo left to the page treatment: the page "
                              "was deskewed after the photo was cut out")
        else:
            report.append(f"skew {ang:+.2f}° — left as is")

    # 6. neutralize the photo's colour cast on the ink, keep genuinely coloured ink
    if o.gray:
        stage("gray", "-colorspace", "gray", "-colorspace", "sRGB",
              "-type", "TrueColor")
        report.append("grayscale output")
    elif not o.no_neutralize:
        # One process, not six. Each of the six wrote a full-resolution PNG for
        # the next one to read back, and at 12 MP that handoff cost more than
        # the arithmetic it carried. mpr: keeps the page in memory, and -print
        # hands the coverage back without a seventh read of the mask.
        # Coloured ink = high chroma AND dark. Chroma alone also fires on the
        # warm cast of a bright paper edge and on JPEG chroma speckle, so both
        # conditions are required, then an opening drops single-pixel noise.
        step += 1
        nxt = f"{out_png}.s{step}-neutral.png"
        share = float(magick(
            cur, "-write", "mpr:flat",
            # Split the channels ONCE and take both the max and the min off
            # that one split, instead of splitting the page twice. The split is
            # parked in a register rather than addressed by index, because a
            # grayscale source -- a PDF with a gray image in it -- separates
            # into ONE plane, and any "planes 0 to 2" form dies on it.
            "(", "+clone", "-channel", "RGB", "-separate", "+channel",
            "-write", "mpr:ch", "-evaluate-sequence", "max",
            "(", "mpr:ch", "-evaluate-sequence", "min", ")",
            "-compose", op_minus(), "-composite", "-alpha", "off", ")",
            "-delete", "0",
            "-threshold", f"{o.chroma}%",
            "(", "mpr:flat", "-colorspace", "gray",
            "-threshold", f"{o.ink_dark}%", "-negate", "-alpha", "off", ")",
            "-compose", "Multiply", "-composite",
            "-morphology", "Open", "Octagon:1",
            # Growing and softening a binary mask is a 10px-scale operation,
            # so it does not need full resolution: at a third of it the kernel
            # and the blur scale with it. It is not quite free -- a page of
            # blue biro kept 8.67% of its area coloured instead of 9.02% -- but
            # that is the thinnest ends of strokes going neutral, not a stroke.
            "-sample", "33.3333%",
            "-morphology", "Dilate",
            f"Octagon:{max(1, round(o.chroma_grow / 3))}",
            "-blur", "0x1.3333", "-filter", "Triangle",
            "-resize", f"{iw}x{ih}!", "+filter",
            "-write", "mpr:mask", "-print", "%[fx:mean*100]",
            "-delete", "0",
            "(", "mpr:flat", "-colorspace", "gray", "-colorspace", "sRGB",
            "-type", "TrueColor", ")",
            "mpr:flat", "mpr:mask",
            "-compose", "Over", "-composite", f"PNG24:{nxt}").strip())
        cur = nxt
        report.append(f"ink neutralized, coloured ink kept on {share:.3f}% of the page")

    # 7-9. tone, haze and paper-flattening in ONE pass over the pixels.
    #    tone: paper to white, ink deep — percentile based, not a fixed curve.
    #    haze: erase leftover smooth haze — a soft shadow, a finger, an edge
    #      glow. Bright AND featureless -> paper; anything with structure (ink,
    #      a faint stamp, a pencil note) has local variance and survives.
    #    white: clean the paper to pure white, protecting a 1px ring around ink.
    #    They used to be four processes handing a full-resolution PNG along;
    #    the writes cost more than the arithmetic. Same operators, same order.
    args = ["-contrast-stretch", f"{o.black_clip}%x{o.white_clip}%"]
    if not o.no_haze:
        args += ["-write", "mpr:toned",
                 # This one stays at FULL resolution, deliberately. Measuring
                 # the variance on a half-scale copy is 0.3s cheaper and looks
                 # harmless by RMSE, but point-sampling destroys exactly the
                 # fine texture the test is looking for: printed rules and
                 # digits read as featureless, get screened to white, and the
                 # page comes back with content missing. Tried and reverted.
                 "(", "mpr:toned", "-colorspace", "gray",
                 "(", "+clone", "-statistic", "StandardDeviation", "7x7",
                 "-threshold", f"{o.haze_std}%", "-negate", ")",
                 "(", "-clone", "0", "-threshold", f"{o.haze_min}%", ")",
                 "-delete", "0", "-compose", "Multiply", "-composite",
                 "-morphology", "Erode", "Octagon:2", "-alpha", "off", ")",
                 "-compose", "Screen", "-composite"]
    if not o.no_flatten_paper:
        args += ["(", "+clone", "-colorspace", "gray",
                 "-threshold", f"{o.paper_thr}%",
                 "-morphology", "Erode", "Octagon:1", "-alpha", "off", ")",
                 "-compose", "Screen", "-composite"]
    stage("tone", *args)

    # 10. fit onto A4
    iw, ih = (int(x) for x in fmt(cur, "%w %h").split())
    page_dpi = o.dpi
    pw = round(210 / MM * page_dpi)
    ph = round(297 / MM * page_dpi)
    # The page turns, not the picture -- the rule photo mode has always used.
    # A near-square page has no meaningful orientation, so a few percent
    # between the sides is noise, not a decision.
    turned = iw > ih * (1.0 + o.rotate_tol / 100.0) and not o.landscape
    if o.landscape or turned:
        pw, ph = ph, pw

    scale, off_x, off_y, mode_used = None, None, None, None
    if rectified and o.fit == "auto":
        scale = min(pw / iw, ph / ih)
        mode_used = "frame (the rectified quad is the sheet)"
    if scale is None and o.fit in ("auto", "edges"):
        # Both edges of one axis found => that axis spans the whole sheet, so it
        # gives the true px-per-mm without guessing anything about the layout.
        if flags.get("top") and flags.get("bottom"):
            scale = ph / span["h"]
            off_y = round(shave["t"] * scale)
            mode_used = f"edges (sheet height = {span['h']}px)"
        elif flags.get("left") and flags.get("right"):
            scale = pw / span["w"]
            off_x = round(shave["l"] * scale)
            mode_used = f"edges (sheet width = {span['w']}px)"
        elif o.fit == "edges":
            mode_used = "frame (no pair of opposite edges found)"
    if scale is None and o.fit in ("auto", "content"):
        # The content fit invents the scale from an ASSUMED text width. That is
        # only defensible when the frame is cropped tight to the ink and the
        # margins genuinely have to be guessed. If any sheet edge was found the
        # sheet is inside the frame, there is nothing to guess, and anchoring on
        # a 165 mm text column shrinks a wide worksheet to two thirds of the
        # page -- measured 2.11 where fitting the frame gives 2.69 and the real
        # sheet gives 3.15. --fit content still forces it.
        if o.fit == "auto" and any(flags.get(k) for k in
                                   ("left", "right", "top", "bottom")):
            mode_used = "frame (a sheet edge was found; no text width to guess)"
        else:
            bb = ink_bbox(cur)
            if bb and bb[2] >= o.content_min / 100.0 * iw:
                bx, by, bw, _ = bb
                text_w = (297 if o.landscape else 210) - o.ml - o.mr
                s = (text_w / MM * o.dpi) / bw
                if 0.4 <= s <= 3.0:
                    scale = s
                    off_x = round(o.ml / MM * o.dpi - bx * s)
                    off_y = round(o.mt / MM * o.dpi - by * s)
                    mode_used = (f"content ({bw}px ink block -> {text_w:.0f}mm "
                                 f"text width at {o.ml:.0f}/{o.mr:.0f}/{o.mt:.0f}mm)")
            if scale is None:
                mode_used = "frame (no ink block wide enough to anchor on)"
    if scale is None:
        scale = min(pw / iw, ph / ih)
        mode_used = mode_used or "frame"
    if off_x is None:
        off_x = round((pw - iw * scale) / 2)
    if off_y is None:
        off_y = round((ph - ih * scale) / 2)

    # A page is only as sharp as the photo it came from. Laid onto A4 at
    # 300 dpi, a 1280x960 snapshot of a passport spread is blown up 2x: half
    # the pixels of the page are invented, and they cost the same bytes as
    # real ones -- 1.6 MB for one page. When the photo holds less than
    # LOWRES_DPI of detail at the size it lands, the page is written at 200
    # dpi with 4:2:0 chroma (the phone's own JPEG already threw that colour
    # resolution away): 577 KB instead, with no visible difference side by
    # side. An explicit --dpi is always obeyed.
    lowres = False
    if not o.dpi_given and scale > o.dpi / LOWRES_DPI and o.dpi > 200:
        wide = pw > ph
        pw, ph = round(210 / MM * 200), round(297 / MM * 200)
        if wide:
            pw, ph = ph, pw
        f = pw / (round(297 / MM * o.dpi) if wide else round(210 / MM * o.dpi))
        scale *= f
        off_x, off_y = round(off_x * f), round(off_y * f)
        page_dpi = 200
        lowres = True
    off = (off_x, off_y)

    # The resize and the A4 layout are one process: the scaled page is the
    # single biggest intermediate in the run (A4 at 300 dpi is 8.7 MP), and
    # writing it only for the next process to read it back was the most
    # expensive handoff left.
    page = f"{out_png}"
    over = []
    if keep:
        over = photo_patch(keep, scale, off, o, out_png)
    magick("-size", f"{pw}x{ph}", "xc:white",
           "(", cur, "-resize", f"{scale * 100:.4f}%",
           "-unsharp", f"0x1+{o.sharpen}+0.02", ")",
           "-geometry", f"{off[0]:+d}{off[1]:+d}", "-compose", "Over",
           "-composite",
           "-colorspace", "sRGB", "-geometry", "+0+0",
           "(", "+clone", "-colorspace", "gray", "-threshold", f"{o.paper_thr}%",
           "-morphology", "Erode", "Octagon:1", "-alpha", "off", ")",
           "-compose", "Screen", "-composite", *over, page)
    report.append(f"fit: {mode_used}; scale {scale:.4f}, offset {off[0]:+d}{off[1]:+d}")
    report.append(f"page: {pw}x{ph}px @ {page_dpi}dpi")
    if lowres:
        report.append(f"the photo holds about {o.dpi / (scale / f):.0f} dpi of "
                      f"detail at this size — page written at {page_dpi} dpi, "
                      f"not {o.dpi} (--dpi forces it)")
    return page, False, page_dpi


def write_pdf(jpegs, out, dpi, label=None):
    """`dpi` is one number, or one per page."""
    """Write a JPEG-per-page PDF by hand.

    ImageMagick can do this, but only where its PDF coder exists: on Alpine (and
    anywhere else that splits the coder out) writing a PDF silently needs
    ghostscript, a ~90 MB dependency pulled in for a file format that is, for a
    single image per page, a few hundred bytes of boilerplate. Writing it here
    keeps the tool at "ImageMagick + poppler" on every platform and makes the
    output byte-identical across them.
    """
    objs = []

    def add(body):
        objs.append(body)
        return len(objs)

    kids = []
    pages_id = 2  # fixed: catalog is 1, pages is 2
    add(b"<< /Type /Catalog /Pages 2 0 R >>")
    add(b"")  # placeholder for /Pages, filled once the kids are known

    for page_i, jp in enumerate(jpegs):
        page_dpi = dpi[page_i] if isinstance(dpi, (list, tuple)) else dpi
        data = open(jp, "rb").read()
        w, h = (int(x) for x in fmt(jp, "%w %h").split())
        chans = fmt(jp, "%[channels]").lower()
        space = b"/DeviceGray" if "gray" in chans else b"/DeviceRGB"
        pw = w * 72.0 / page_dpi
        ph = h * 72.0 / page_dpi
        img_id = add(b"<< /Type /XObject /Subtype /Image /Width " + str(w).encode() +
                     b" /Height " + str(h).encode() + b" /ColorSpace " + space +
                     b" /BitsPerComponent 8 /Filter /DCTDecode /Length " +
                     str(len(data)).encode() + b" >>\nstream\n" + data +
                     b"\nendstream")
        content = f"q {pw:.4f} 0 0 {ph:.4f} 0 0 cm /Im0 Do Q".encode()
        cont_id = add(b"<< /Length " + str(len(content)).encode() + b" >>\nstream\n" +
                      content + b"\nendstream")
        page_id = add(f"<< /Type /Page /Parent {pages_id} 0 R /MediaBox "
                      f"[0 0 {pw:.4f} {ph:.4f}] /Resources << /XObject << /Im0 "
                      f"{img_id} 0 R >> /ProcSet [/PDF /ImageB /ImageC] >> "
                      f"/Contents {cont_id} 0 R >>".encode())
        kids.append(page_id)

    objs[pages_id - 1] = (b"<< /Type /Pages /Count " + str(len(kids)).encode() +
                          b" /Kids [" +
                          b" ".join(f"{k} 0 R".encode() for k in kids) + b"] >>")

    buf = bytearray(b"%PDF-1.4\n%\xe2\xe3\xcf\xd3\n")
    offsets = [0] * (len(objs) + 1)
    for i, body in enumerate(objs, start=1):
        offsets[i] = len(buf)
        buf += str(i).encode() + b" 0 obj\n" + body + b"\nendobj\n"
    xref = len(buf)
    buf += b"xref\n0 " + str(len(objs) + 1).encode() + b"\n"
    buf += b"0000000000 65535 f \n"
    for i in range(1, len(objs) + 1):
        buf += f"{offsets[i]:010d} 00000 n \n".encode()
    buf += (b"trailer\n<< /Size " + str(len(objs) + 1).encode() +
            b" /Root 1 0 R >>\nstartxref\n" + str(xref).encode() + b"\n%%EOF\n")
    open(out, "wb").write(bytes(buf))
    return out


def cleanup(pattern_base):
    d = os.path.dirname(pattern_base) or "."
    base = os.path.basename(pattern_base)
    for f in os.listdir(d):
        if f.startswith(base + "."):
            os.unlink(os.path.join(d, f))


# ------------------------------------------------------------------------ main


def default_out(src, o):
    base = os.path.splitext(os.path.basename(src))[0] + "-A4"
    ext = ".pdf" if o.format == "pdf" else ".jpg"
    return os.path.join(os.path.dirname(os.path.abspath(src)), base + ext)


def build(sources, out, o):
    """Run every source through the pipeline and emit ONE document.

    Several photos of one paper document are the normal case, not the exception:
    a contract is rarely one page. So the pages of every input, in the order
    given, land in a single PDF.
    """
    with tempfile.TemporaryDirectory(prefix="a4norm-") as wd:
        # Every raster goes through the pipeline first; cards are only laid
        # out once all of them are in, because a card's back is usually the
        # NEXT photograph, not the same one.
        items, n = [], 0
        for si, src in enumerate(sources):
            if len(sources) > 1:
                print(f"  [{si + 1}/{len(sources)}] {os.path.basename(src)}")
            rasters = rasterize(src, wd, tag=f"s{si:02d}")
            for r in rasters:
                rep = []
                out_png = os.path.join(wd, f"out-{n:03d}.png")
                got = process_page(r, out_png, o, rep)
                items.append([r, out_png, got, rep])
                n += 1

        # Cards pair up: two in one frame, or one each in two photographs in
        # a row -- front above back on one page. A group needs a face photo
        # on at least one of its cards: an identity document has one, and a
        # bright 16:10 rectangle without one (a screen, a sign) is no card, so
        # its photograph goes back through as a document.
        groups, i = [], 0
        while i < len(items):
            got = items[i][2]
            if got[1] == "cards":
                if (len(got[0]) == 1 and i + 1 < len(items)
                        and items[i + 1][2][1] == "cards"
                        and len(items[i + 1][2][0]) == 1):
                    groups.append([i, i + 1]); i += 2
                    continue
            groups.append([i]); i += 1
        pages, pno = [], 0
        for g in groups:
            first = items[g[0]]
            if first[2][1] == "cards":
                cards = [c for k in g for c in items[k][2][0]]
                if not any(c["front"] for c in cards):
                    for k in g:
                        r, out_png, _, rep = items[k]
                        rep.append("no face photo on any card of this group — "
                                   "not an identity card, scanned as a document")
                        o.cards = "off"
                        items[k][2] = process_page(r, out_png + ".doc.png", o, rep)
                        o.cards = "auto"
                        pno += 1
                        print(f"  page {pno}:")
                        for line in rep:
                            print(f"    - {line}")
                        pages.append(items[k][2])
                        cleanup(items[k][2][0])
                    continue
                # the front goes on top; with two fronts or none, input order
                cards.sort(key=lambda c: not c["front"])
                page = card_page(cards, first[1], o)
                pno += 1
                print(f"  page {pno}:")
                for k in g:
                    for line in items[k][3]:
                        print(f"    - {line}")
                if len(g) > 1:
                    print(f"    - the cards of photos {g[0] + 1} and {g[1] + 1} "
                          f"laid out on one page, front above back")
                print(f"    - page: {round(210 / MM * o.dpi)}x"
                      f"{round(297 / MM * o.dpi)}px @ {o.dpi}dpi, cards at "
                      f"{'page width' if o.card_size == 'fit' else 'real size'}")
                pages.append((page, False, o.dpi))
                for k in g:
                    cleanup(items[k][1])
                continue
            page, is_photo, page_dpi = first[2]
            pno += 1
            print(f"  page {pno}:")
            for line in first[3]:
                print(f"    - {line}")
            pages.append((page, is_photo, page_dpi))
            cleanup(page)
        if o.dry_run:
            print("  (dry run — nothing written)")
            return None

        # Text wants full chroma; a snapshot does not, and 4:2:0 at a lower
        # quality is the difference between a 2.4 MB page and a third of that
        # with nothing visible lost.
        def encode(src_png, dst, is_photo, page_dpi, extra=()):
            q = o.photo_quality if is_photo else o.quality
            # a page written below --dpi because the photo held no more
            # detail has no full-resolution chroma to keep either
            sub = "2x2" if is_photo or page_dpi < o.dpi else "1x1"
            magick(src_png, "-quality", str(q),
                   "-sampling-factor", sub, "-strip", *extra, dst)

        if o.format == "pdf":
            jpegs, dpis = [], []
            for i, (page, is_photo, page_dpi) in enumerate(pages):
                jp = os.path.join(wd, f"jp-{i:03d}.jpg")
                encode(page, jp, is_photo, page_dpi)
                jpegs.append(jp)
                dpis.append(page_dpi)
            write_pdf(jpegs, out, dpis)
            written = [out]
        else:
            stem, ext = os.path.splitext(out)
            ext = ext or ".jpg"
            written = []
            for i, (page, is_photo, page_dpi) in enumerate(pages):
                dst = out if len(pages) == 1 else f"{stem}-{i + 1}{ext}"
                encode(page, dst, is_photo, page_dpi,
                       ("-density", str(page_dpi), "-units", "PixelsPerInch"))
                written.append(dst)
        if o.preview:
            magick(pages[0][0], "-resize", "900x",
                   "-define", "png:compression-level=6",
                   os.path.splitext(out)[0] + "-preview.png")
    return written


def main():
    p = argparse.ArgumentParser(
        prog="a4norm",
        description="Photo of a document -> scanner-like A4 PDF.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter)
    p.add_argument("inputs", nargs="+", metavar="INPUT",
                   help="PDF / JPG / PNG / HEIC")
    p.add_argument("-o", "--output",
                   help="output file; with several inputs it is the one combined "
                        "document")
    p.add_argument("--format", default="pdf", choices=["pdf", "jpg"],
                   help="output format")
    p.add_argument("--separate", action="store_true",
                   help="one document per input instead of one combined document")
    p.add_argument("--dpi", type=int, default=None,
                   help="page resolution (default 300; a page whose photo "
                        "holds much less detail is written at 200 unless "
                        "this is given)")
    p.add_argument("--quality", type=int, default=88, help="JPEG quality")
    p.add_argument("--photo-quality", type=int, default=82,
                   help="JPEG quality for a page that holds no document")
    p.add_argument("--photo-dpi", type=int, default=200,
                   help="raster resolution for a page that holds no document; "
                        "300 dpi is for text, a snapshot does not need it")
    p.add_argument("--gray", action="store_true", help="grayscale output")
    p.add_argument("--landscape", action="store_true", help="A4 landscape")
    p.add_argument("--rotate", default="auto",
                   choices=["auto", "0", "90", "180", "270"])
    p.add_argument("--spread", default="auto", choices=["auto", "on", "off"],
                   help="an open booklet (a passport) photographed with both "
                        "pages showing: each page is rectified on its own and "
                        "the two are joined at the fold; auto = when two "
                        "facing pages are found")
    p.add_argument("--cards", default="auto", choices=["auto", "off"],
                   help="an ID card or a driving licence (ISO ID-1): each card "
                        "rectified to its real size and turned upright, front "
                        "and back -- from one photo or two in a row -- on one "
                        "A4, front on top")
    p.add_argument("--card-size", default="actual", choices=["actual", "fit"],
                   help="cards at their real 85.6x54 mm, or blown up to the "
                        "page width")
    p.add_argument("--edges", default="auto", choices=["auto", "off"],
                   help="read the document's edges as lines when brightness "
                        "cannot find it (a white page on a white desk, a "
                        "page whose pictures broke the paper mask)")
    p.add_argument("--rectify", default="auto", choices=["auto", "on", "off"],
                   help="warp the sheet's quadrilateral flat before anything "
                        "else; auto = only when a convincing quad is found")
    p.add_argument("--photo", default="auto", choices=["auto", "on", "off"],
                   help="what to do with a frame that holds no document: auto "
                        "detects it and keeps the picture as it is (no "
                        "flat-field, no deskew, no tone), on forces that, off "
                        "always applies the scanner treatment")
    p.add_argument("--fit", default="auto",
                   choices=["auto", "edges", "content", "frame"],
                   help="how to derive the scale onto A4")
    p.add_argument("--margins", default="30,15,20",
                   help="left,right,top in mm, used by the content fit")
    p.add_argument("--dry-run", action="store_true",
                   help="analyze and report, write nothing")
    p.add_argument("--preview", action="store_true",
                   help="also write a small PNG preview to eyeball")
    # tuning knobs — defaults work for ordinary text documents
    g = p.add_argument_group("tuning")
    g.add_argument("--trim-band", type=float, default=8.0,
                   help="%% of each side searched for the photo border")
    g.add_argument("--trim-step", type=float, default=6.0,
                   help="minimum brightness step counted as an edge (0-255)")
    g.add_argument("--trim-pad", type=int, default=6,
                   help="minimum px cut inside a detected edge")
    g.add_argument("--trim-shave", type=float, default=1.0,
                   help="%% of the short side shaved inside a detected edge, to "
                        "drop the edge shadow (does not affect the A4 scale)")
    g.add_argument("--photo-paper", type=float, default=20.0,
                   help="%% paper-like area below which a frame counts as a "
                        "photo rather than a document")
    g.add_argument("--rect-inset", type=float, default=0.8,
                   help="%% the detected quad is pulled in before warping")
    g.add_argument("--edge-band", type=float, default=10.0,
                   help="%% of the short side the border flood may reach in")
    g.add_argument("--edge-keep", type=float, default=1.0,
                   help="%% of the short side the border flood may reach in on "
                        "a side judged to be document — a shaded panel of a "
                        "printed form that happens to touch the sheet edge")
    g.add_argument("--band-structure", type=float, default=6.0,
                   help="%% printed-mark density in a flooded border band above "
                        "which that band is document: never cropped, flooded "
                        "only as far as --edge-keep")
    g.add_argument("--band-dark", type=float, default=60.0,
                   help="%% of the page's own paper level a flooded border band "
                        "must be darker than to count as something leaning in "
                        "from outside the sheet; brighter than that it is a "
                        "shaded part of the document")
    g.add_argument("--no-edge-clean", action="store_true")
    g.add_argument("--close", type=int, default=6,
                   help="ink-removal radius for the background estimate")
    g.add_argument("--bg-scale", type=float, default=6.0,
                   help="%% downscale of the background estimate")
    g.add_argument("--chroma", type=float, default=7.0,
                   help="%% chroma above which ink counts as coloured")
    g.add_argument("--ink-dark", type=float, default=85.0,
                   help="%% brightness below which a pixel can be coloured ink")
    g.add_argument("--chroma-grow", type=int, default=6,
                   help="px the coloured-ink mask is grown to cover stroke edges")
    g.add_argument("--black-clip", type=float, default=0.1,
                   help="%% darkest pixels driven to black")
    g.add_argument("--white-clip", type=float, default=2.0,
                   help="%% brightest pixels driven to white")
    g.add_argument("--haze-min", type=float, default=83.0,
                   help="%% brightness above which featureless area counts as haze")
    g.add_argument("--haze-std", type=float, default=2.0,
                   help="%% local std below which an area counts as featureless")
    g.add_argument("--no-haze", action="store_true",
                   help="keep soft shadows / smooth light-grey fills")
    g.add_argument("--paper-thr", type=float, default=80.0,
                   help="%% brightness above which paper is cleaned to pure white")
    g.add_argument("--sharpen", type=float, default=0.55)
    g.add_argument("--content-min", type=float, default=45.0,
                   help="%% of frame width the ink block must span for a content fit")
    g.add_argument("--rotate-tol", type=float, default=5.0,
                   help="%% the sides must differ by before --rotate auto turns "
                        "a page; below it the page counts as square")
    g.add_argument("--deskew-min", type=float, default=0.4,
                   help="degrees below which skew is left alone")
    g.add_argument("--no-trim", action="store_true")
    g.add_argument("--no-deskew", action="store_true")
    g.add_argument("--no-neutralize", action="store_true")
    g.add_argument("--no-keep-photo", action="store_true",
                   help="treat a face photo like the rest of the page instead "
                        "of toning it on its own (it gets bleached)")
    g.add_argument("--no-flatten-paper", action="store_true",
                   help="keep paper texture instead of cleaning it to white")
    o = p.parse_args()
    o.dpi_given = o.dpi is not None
    if o.dpi is None:
        o.dpi = 300

    try:
        o.ml, o.mr, o.mt = (float(x) for x in o.margins.split(","))
    except ValueError:
        sys.exit("a4norm: --margins wants three numbers, e.g. 30,15,20")

    for t in ("magick", "pdfinfo", "pdfimages", "pdftoppm"):
        need(t)

    for src in o.inputs:
        if not os.path.exists(src):
            sys.exit(f"a4norm: no such file: {src}")

    # One document out of everything given, unless --separate asks otherwise.
    groups = ([[s] for s in o.inputs] if o.separate else [o.inputs])
    for group in groups:
        print(", ".join(group) if len(group) > 1 else group[0])
        out = o.output if (o.output and len(groups) == 1) else default_out(group[0], o)
        written = build(group, out, o)
        if written:
            for w in written:
                print(f"  -> {w}  ({os.path.getsize(w) / 1024:.0f} KB)")


if __name__ == "__main__":
    main()
